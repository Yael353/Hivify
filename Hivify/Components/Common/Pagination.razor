@using MudBlazor

@if (TotalItems > 0)
{
    <div class="pagination-container">
        <!-- Info om antal – dold på mobil, synlig på desktop -->
        <div class="pagination-info d-none d-sm-block text-muted small">
            Visar @(Skip + 1) - @(Math.Min(Skip + PageSize, TotalItems)) av @TotalItems
        </div>

        <!-- Navigeringsknappar – centrerad på mobil -->
        <div class="pagination-nav">
            <MudButton Variant="Variant.Outlined"
                       Size="Size.Small"
                       Disabled="@(Skip == 0)"
                       OnClick="@(() => OnPageChanged.InvokeAsync(Skip - PageSize))">
                <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" />
            </MudButton>

            @for (int i = 0; i < TotalPages; i++)
            {
                var pageNumber = i + 1;
                var isActive = i == CurrentPageIndex;

                <MudButton Variant="@(isActive ? Variant.Filled : Variant.Outlined)"
                           Color="@(isActive ? Color.Primary : Color.Default)"
                           Size="Size.Small"
                           Style="@(isActive ? "min-width: 32px; cursor: default;" : "min-width: 32px;")"
                           OnClick="@(() => !isActive ? OnPageChanged.InvokeAsync(i * PageSize) : Task.CompletedTask)">
                    @pageNumber
                </MudButton>
            }

            <MudButton Variant="Variant.Outlined"
                       Size="Size.Small"
                       Disabled="@(Skip + PageSize >= TotalItems)"
                       OnClick="@(() => OnPageChanged.InvokeAsync(Skip + PageSize))">
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
            </MudButton>
        </div>
    </div>
}

<style>
    .pagination-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 1.5rem;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .pagination-nav {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    /* Mobil – centrera allt */
    @@media (max-width: 576px) {
        .pagination-container {
            justify-content: center;
            flex-direction: column;
            gap: 0.5rem;
        }

        .pagination-info {
            text-align: center;
        }

        .pagination-nav {
            gap: 0.25rem;
        }
    }

    /* Tablet – info till vänster, knappar till höger */
    @@media (min-width: 577px) and (max-width: 768px) {
        .pagination-container {
            justify-content: space-between;
        }
    }
</style>

@code {
    [Parameter]
    public int TotalItems { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 10;

    [Parameter]
    public int Skip { get; set; } = 0;

    [Parameter]
    public EventCallback<int> OnPageChanged { get; set; }

    private int CurrentPageIndex => Skip / PageSize;
    private int TotalPages => (int)Math.Ceiling((double)TotalItems / PageSize);
}