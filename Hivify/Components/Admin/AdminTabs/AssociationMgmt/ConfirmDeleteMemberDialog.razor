@using MudBlazor

<MudDialog>

  <DialogContent>

    <MudText Typo="Typo.body1">

      Är du säker på att du vill ta bort
      <strong>@MemberName</strong>
      som styrelsemedlem?

    </MudText>

    <MudText Typo="Typo.body2"
      Color="Color.Secondary"
      Class="mt-2">

      Personen kommer inte längre att vara styrelsemedlem
      i denna förening.

    </MudText>

  </DialogContent>

  <DialogActions>

    <MudButton Variant="Variant.Text"
      OnClick="Cancel">

      Avbryt

    </MudButton>

    <MudButton Variant="Variant.Filled"
      Color="Color.Error"
      OnClick="Confirm">

      Ta bort

    </MudButton>

  </DialogActions>

</MudDialog>

@code {

  [CascadingParameter]
  private IMudDialogInstance MudDialog { get; set; } = default!;

  [Parameter]
  public string MemberName { get; set; } = string.Empty;


  private void Cancel()
  {
    MudDialog.Cancel();
  }


  private void Confirm()
  {
    MudDialog.Close(
        DialogResult.Ok(true));
  }
}