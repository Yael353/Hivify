
@using Hivify.Core.Aggregates.Associations.Members
@using Hivify.UseCases.Abstractions.Messaging
@using Hivify.UseCases.Association.Commands.AddStaffMember
@using Hivify.UseCases.AdminUserMgmt.DTOs
@using Hivify.Components.Admin.AdminTabs.AdminUserMgmt
@using MudBlazor

@inject ISender Sender
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<AddAssociationMember> Logger

<MudButton Variant="Variant.Filled"
  Color="Color.Primary"
  StartIcon="@Icons.Material.Filled.PersonAdd"
  Disabled="_saving"
  OnClick="OpenUserPickerAsync">

  @(_saving ? "Lägger till..." : "Lägg till styrelsemedlem")

</MudButton>

@code {

  [Parameter, EditorRequired]
  public Guid AssociationId { get; set; }

  [Parameter]
  public EventCallback OnMemberAdded { get; set; }

  private bool _saving;


  private async Task OpenUserPickerAsync()
  {
    if (_saving)
      return;

    var options = new DialogOptions
    {
      CloseOnEscapeKey = true,
      MaxWidth = MaxWidth.Small,
      FullWidth = true
    };

    var dialog =
        await DialogService.ShowAsync<UserPickerDialog>(
            "Välj användare",
            options);

    var result = await dialog.Result;

    if (result.Canceled)
      return;

    if (result.Data is not UserListItem selectedUser)
      return;

    await AddMemberAsync(selectedUser);
  }


  private async Task AddMemberAsync(
      UserListItem user)
  {
    if (_saving)
      return;

    _saving = true;

    try
    {
      var fullName = GetUserDisplayName(user);

      await Sender.Send(
          new AddStaffMemberCommand(
              AssociationId,
              user.Id,
              fullName,
              user.Email,
              MemberRole.StyrelseLedamot));

      Snackbar.Add(
          "Styrelsemedlemmen lades till.",
          Severity.Success);

      await OnMemberAdded.InvokeAsync();
    }
    catch (Exception ex)
    {
      Logger.LogError(
          ex,
          "Failed to add member {UserId} to association {AssociationId}",
          user.Id,
          AssociationId);

      Snackbar.Add(
          "Kunde inte lägga till styrelsemedlemmen.",
          Severity.Error);
    }
    finally
    {
      _saving = false;
    }
  }


  private static string GetUserDisplayName(
      UserListItem user)
  {
    return user.FullName
        ?? user.UserName
        ?? user.Email
        ?? user.Id.ToString();
  }
}

