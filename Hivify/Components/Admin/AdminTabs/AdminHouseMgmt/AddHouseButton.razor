@using Hivify.UseCases.Abstractions.Messaging
@using Hivify.UseCases.Houses.Commands.CreateHouse
@using MudBlazor

@inject ISender Sender
@inject ISnackbar Snackbar
@inject ILogger<AddHouseButton> Logger


<MudPaper Class="pa-4" Elevation="2" Style="border-radius: 12px;">

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenForm"
               FullWidth="true">
        Lägg till nytt hus
    </MudButton>

    @if (_isAdding)
    {
        <MudPaper Class="pa-4 mt-4"
                  Elevation="1"
                  Style="border-radius: 12px; border: 1px solid #e9edf2;">

            <MudText Typo="Typo.body1"
                     Color="Color.Primary"
                     Class="font-weight-bold mb-3">
                Nytt hus
            </MudText>

            <MudStack Spacing="3">

                <MudTextField Label="Adress"
                              @bind-Value="_address"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Adress är obligatorisk" />

                <MudTextField Label="Husnummer"
                              @bind-Value="_houseNumber"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Husnummer är obligatoriskt" />

                <MudTextField Label="Postnummer"
                              @bind-Value="_postalCode"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Postnummer är obligatoriskt" />

                <MudStack Row="true"
                          Spacing="2"
                          Justify="Justify.FlexEnd">

                    <MudButton Color="Color.Default"
                               Variant="Variant.Outlined"
                               Disabled="_saving"
                               OnClick="Cancel">
                        Avbryt
                    </MudButton>

                    <MudButton Color="Color.Success"
                               Variant="Variant.Filled"
                               Disabled="_saving"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveHouseAsync">

                        @(_saving ? "Sparar..." : "Spara")

                    </MudButton>

                </MudStack>

            </MudStack>

        </MudPaper>
    }

</MudPaper>

@code {

    [Parameter]
    public EventCallback OnHouseAdded { get; set; }

    private bool _isAdding;
    private bool _saving;

    private string _address = string.Empty;
    private string _houseNumber = string.Empty;
    private string _postalCode = string.Empty;

    private void OpenForm()
    {
        _isAdding = true;
    }

    private void Cancel()
    {
        ResetForm();
        _isAdding = false;
    }

    private async Task SaveHouseAsync()
    {
        if (_saving)
            return;

        if (string.IsNullOrWhiteSpace(_address) ||
            string.IsNullOrWhiteSpace(_houseNumber) ||
            string.IsNullOrWhiteSpace(_postalCode))
        {
            Snackbar.Add(
                "Fyll i alla fält.",
                Severity.Warning);

            return;
        }

        try
        {
            _saving = true;

            var command = new AddHouseCommand(
                _address.Trim(),
                _houseNumber.Trim(),
                _postalCode.Trim());

            await Sender.Send(command);

            Snackbar.Add(
                "Huset skapades!",
                Severity.Success);

            ResetForm();
            _isAdding = false;

            await OnHouseAdded.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error creating house");

            Snackbar.Add(
                "Kunde inte skapa huset.",
                Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void ResetForm()
    {
        _address = string.Empty;
        _houseNumber = string.Empty;
        _postalCode = string.Empty;
    }
}