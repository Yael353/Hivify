@using Hivify.UseCases.Abstractions.Messaging
@using Hivify.UseCases.Houses.Commands.UpdateHouse
@using Hivify.UseCases.Houses.DTOs
@using MudBlazor

@inject ISender Sender
@inject ISnackbar Snackbar
@inject ILogger<AdminEditHouse> Logger

<MudText Typo="Typo.subtitle1"
  Color="Color.Primary"
  Class="font-weight-bold mb-3">
  Redigera hus
</MudText>

<MudStack Spacing="3">

  <MudTextField Label="Adress"
    @bind-Value="_address"
    Variant="Variant.Outlined"
    Required="true"
    RequiredError="Adress är obligatorisk" />

  <MudTextField Label="Husnummer"
    @bind-Value="_houseNumber"
    Variant="Variant.Outlined"
    Required="true"
    RequiredError="Husnummer är obligatoriskt" />

  <MudTextField Label="Postnummer"
    @bind-Value="_postalCode"
    Variant="Variant.Outlined"
    Required="true"
    RequiredError="Postnummer är obligatoriskt" />

  <MudStack Row="true"
    Justify="Justify.FlexEnd"
    Spacing="2">

    <MudButton Variant="Variant.Outlined"
      Color="Color.Default"
      Disabled="_saving"
      OnClick="ResetForm">

      Återställ

    </MudButton>

    <MudButton Variant="Variant.Filled"
      Color="Color.Primary"
      Disabled="_saving"
      StartIcon="@Icons.Material.Filled.Save"
      OnClick="UpdateHouseAsync">

      @(_saving ? "Sparar..." : "Spara ändringar")

    </MudButton>

  </MudStack>

</MudStack>

@code {

  [Parameter, EditorRequired]
  public HouseListItemDto House { get; set; } = default!;

  [Parameter]
  public EventCallback OnHouseUpdated { get; set; }

  private bool _saving;

  private string _address = string.Empty;
  private string _houseNumber = string.Empty;
  private string _postalCode = string.Empty;

  protected override void OnParametersSet()
  {
    ResetForm();
  }

  private void ResetForm()
  {
    _address = House.Address;
    _houseNumber = House.HouseNumber;
    _postalCode = House.PostalCode;
  }

  private async Task UpdateHouseAsync()
  {
    if (_saving)
      return;

    if (string.IsNullOrWhiteSpace(_address) ||
        string.IsNullOrWhiteSpace(_houseNumber) ||
        string.IsNullOrWhiteSpace(_postalCode))
    {
      Snackbar.Add(
          "Fyll i alla fält.",
          Severity.Warning);

      return;
    }

    try
    {
      _saving = true;

      var command = new UpdateHouseCommand(
          House.Id,
          _address.Trim(),
          _houseNumber.Trim(),
          _postalCode.Trim());

      var updated = await Sender.Send(command);

      if (!updated)
      {
        Snackbar.Add(
            "Huset kunde inte hittas.",
            Severity.Error);

        return;
      }

      Snackbar.Add(
          "Huset uppdaterades!",
          Severity.Success);

      await OnHouseUpdated.InvokeAsync();
    }
    catch (Exception ex)
    {
      Logger.LogError(
          ex,
          "Error updating house {HouseId}",
          House.Id);

      Snackbar.Add(
          "Kunde inte uppdatera huset.",
          Severity.Error);
    }
    finally
    {
      _saving = false;
    }
  }
}
