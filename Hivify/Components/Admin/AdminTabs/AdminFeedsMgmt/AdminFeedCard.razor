@attribute [Authorize(Roles = "Admin")]

@using Hivify.UseCases.Feeds.DTOs
@using Microsoft.AspNetCore.Authorization
@using MudBlazor

<MudCard Class="feed-card" Elevation="1" Style="border-left: 4px solid #3f51b5;">

    @if (_editing)
    {
        <EditFeedForm Feed="Feed"
                      OnSaved="HandleSaved"
                      OnCancelled="HandleCancelled" />
    }
    else
    {
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6" Color="Color.Default" Class="font-weight-medium">
                    @Feed.Title
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="StartEdit" />
                <FeedActions FeedId="Feed.Id"
                             OnDeleted="HandleDeleted" />
            </CardHeaderActions>
        </MudCardHeader>

        <MudDivider Class="mx-4" Style="opacity: 0.4;" />

        <MudCardContent Class="pa-5">
            <MudText Typo="Typo.body2"
                     Color="Color.Default"
                     Style="white-space: pre-wrap; line-height: 1.7; color: #333333;">
                @Feed.Content
            </MudText>

            <MudDivider Class="my-3" Style="opacity: 0.2;" />

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Schedule"
                         Size="Size.Small"
                         Color="Color.Tertiary" />
                <MudText Typo="Typo.caption" Color="Color.Tertiary">
                    @Feed.CreatedDate.ToString("dd MMM yyyy, HH:mm")
                </MudText>
            </MudStack>
        </MudCardContent>
    }
</MudCard>

<style>
    .feed-card {
        border-radius: 14px;
        transition: all 0.25s ease;
        background: #ffffff;
        border: 1px solid #e8ecf0;
    }

        .feed-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 32px rgba(63, 81, 181, 0.08) !important;
            border-color: #c5cae9;
        }
</style>

@code {
    [Parameter]
    public FeedListItemDto Feed { get; set; } = default!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private bool _editing;

    private void StartEdit() => _editing = true;
    private void HandleCancelled() => _editing = false;

    private async Task HandleSaved()
    {
        _editing = false;
        await OnChanged.InvokeAsync();
    }

    private async Task HandleDeleted() => await OnChanged.InvokeAsync();
}