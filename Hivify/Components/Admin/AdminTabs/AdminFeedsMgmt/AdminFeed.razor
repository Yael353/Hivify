@using MudBlazor

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">

    <MudStack Spacing="4">

        <CreateFeedForm OnCreated="RefreshFeeds" />

        <AIFeedGenerator />

        <MudPaper Class="pa-4"
                  Elevation="0"
                  Style="border: 1px solid #e9edf2; border-radius: 12px;">

            <MudText Typo="Typo.h6"
                     Class="mb-3">

                Befintliga nyheter

            </MudText>

            <MudDivider Class="mb-4" />

            <AdminFeedList @ref="_feedList" />

        </MudPaper>

    </MudStack>

</MudContainer>

@code {

    private AdminFeedList? _feedList;

    protected override async Task OnInitializedAsync()
    {
        await RefreshFeeds();
    }

    private async Task RefreshFeeds()
    {
        if (_feedList is not null)
        {
            await _feedList.Refresh();
        }
    }
}