@using System.Security.Claims

<li class="nav-item dropdown">
		<a class="nav-link dropdown-toggle user-menu-toggle px-lg-3"
			 href="#"
			 data-bs-toggle="dropdown"
			 aria-expanded="false">
				<MudAvatar Color="Color.Primary" Size="Size.Small">
						@Initial
				</MudAvatar>
		</a>

		<ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
		<li>
			<div class="dropdown-item-text d-flex align-items-center py-2">
				<div class="rounded-circle bg-primary text-white d-flex justify-content-center align-items-center me-3"
						 style="width:40px; height:40px;">
					@DisplayName.Substring(0, 1).ToUpper()
				</div>

				<div>
					<div class="fw-semibold">@DisplayName</div>
			
				</div>
			</div>
		</li>
		<li><hr class="dropdown-divider"></li>
		<li>
			<NavLink class="dropdown-item" href="Account/Manage">
				Profile
			</NavLink>
		</li>

		<li>
			<NavLink class="dropdown-item" href="/mina-arenden">
				Mina ärenden
			</NavLink>
		</li>

		<li><hr class="dropdown-divider"></li>

		<li>
			<form action="Account/Logout" method="post">
				<AntiforgeryToken />
				<input type="hidden" name="ReturnUrl" value="@CurrentUrl" />
				<button class="dropdown-item" type="submit">
					Logout
				</button>
			</form>
		</li>
		</ul>
</li>

@code {
		[Parameter]
		public string? CurrentUrl { get; set; }

		[Parameter]
		public ClaimsPrincipal? User { get; set; }

		private string DisplayName => User?.Identity?.Name ?? "User";

		private string Initial =>
				string.IsNullOrWhiteSpace(DisplayName)
						? "U"
						: DisplayName[0].ToString().ToUpperInvariant();
}
