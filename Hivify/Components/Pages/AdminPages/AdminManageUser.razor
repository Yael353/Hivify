@page "/admin/usermanagement/{UserId:guid}"
@layout AdminLayout
@rendermode InteractiveServer

@using Hivify.Components.Admin.AdminTabs.AdminUserMgmt
@using Hivify.UseCases.Abstractions.Presistence
@using Hivify.UseCases.AdminUserMgmt.DTOs
@using MudBlazor

@inject IUserRepo UserManagementService
@inject NavigationManager NavigationManager

<PageTitle>Admin – Användare</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">

  @if (_loading)
  {
    <div class="d-flex justify-center pa-6">

      <MudProgressCircular Indeterminate="true"
        Color="Color.Primary" />

    </div>
  }
  else if (_user is null)
  {
    <MudAlert Severity="Severity.Error"
      Variant="Variant.Outlined">

      Användaren kunde inte hittas.

    </MudAlert>
  }
  else
  {
    <MudStack Spacing="4">

      <!-- Header -->

      <MudStack Row="true"
        AlignItems="AlignItems.Center"
        Spacing="2">

        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
          Color="Color.Default"
          OnClick="GoBack" />

        <MudStack Spacing="0">

          <MudText Typo="Typo.h5"
            Color="Color.Primary"
            Class="font-weight-bold">

            Hantera användare

          </MudText>

          <MudText Typo="Typo.body2"
            Color="Color.Tertiary">

            Administrera användarens kopplingar till föreningen.

          </MudText>

        </MudStack>

      </MudStack>


      <!-- Identity information -->

      <MudPaper Class="pa-4"
        Elevation="2"
        Style="border-radius: 12px;">

        <MudText Typo="Typo.h6"
          Color="Color.Primary"
          Class="mb-4">

          Användarinformation

        </MudText>

        <MudGrid>

          <!-- Username -->

          <MudItem xs="12" md="6">

            <MudText Typo="Typo.caption"
              Color="Color.Tertiary">

              Användarnamn

            </MudText>

            <MudText Typo="Typo.body1">

              @(_user.UserName ?? "—")

            </MudText>

          </MudItem>


          <!-- Email -->

          <MudItem xs="12" md="6">

            <MudText Typo="Typo.caption"
              Color="Color.Tertiary">

              E-post

            </MudText>

            <MudText Typo="Typo.body1">

              @(_user.Email ?? "—")

            </MudText>

          </MudItem>


          <!-- Phone -->

          <MudItem xs="12" md="6">

            <MudText Typo="Typo.caption"
              Color="Color.Tertiary">

              Telefonnummer

            </MudText>

            <MudText Typo="Typo.body1">

              @(_user.PhoneNumber ?? "—")

            </MudText>

          </MudItem>


          <!-- Email confirmation -->

          <MudItem xs="12" md="6">

            <MudText Typo="Typo.caption"
              Color="Color.Tertiary">

              E-poststatus

            </MudText>

            @if (_user.EmailConfirmed)
            {
              <MudChip T="string"
                Size="Size.Small"
                Color="Color.Success"
                Variant="Variant.Outlined"
                Icon="@Icons.Material.Filled.Check">

                Bekräftad

              </MudChip>
            }
            else
            {
              <MudChip T="string"
                Size="Size.Small"
                Color="Color.Warning"
                Variant="Variant.Outlined"
                Icon="@Icons.Material.Filled.Warning">

                Ej bekräftad

              </MudChip>
            }

          </MudItem>


          <!-- User ID -->

       

        </MudGrid>

      </MudPaper>

    </MudStack>
  }

</MudContainer>


@code {

  [Parameter]
  public Guid UserId { get; set; }

  private UserListItem? _user;

  private bool _loading;


  protected override async Task OnParametersSetAsync()
  {
    await LoadUserAsync();
  }


  private async Task LoadUserAsync()
  {
    _loading = true;
    _user = null;

    try
    {
      _user =
          await UserManagementService.GetUserByIdAsync(UserId);
    }
    finally
    {
      _loading = false;
    }
  }


  private void GoBack()
  {
    NavigationManager.NavigateTo(
        "/admin/anvandare");
  }
}