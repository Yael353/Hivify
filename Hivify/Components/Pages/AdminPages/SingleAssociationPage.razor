@page "/admin/associations/{AssociationId:guid}"

@layout AdminLayout
@rendermode InteractiveServer

@using Hivify.Components.Admin.AdminTabs.AssociationMgmt
@using Hivify.UseCases.Abstractions.Messaging
@using Hivify.UseCases.Association.Queries.GetAssociation
@using Hivify.UseCases.Association.DTOs

@using Microsoft.AspNetCore.Authorization
@using MudBlazor

@attribute [Authorize(Roles = "Admin")]

@inject IQuerySender QuerySender
@inject NavigationManager NavigationManager

<MudPopoverProvider />
<MudDialogProvider FullWidth="true"
                  MaxWidth="MaxWidth.ExtraSmall"
                  CloseButton="true"
                  BackdropClick="false"
                  NoHeader="true"
                  Position="DialogPosition.Center"
                  CloseOnEscapeKey="true"
                  ReverseMessageBoxButtonOrder="true" />


<div class="container py-4">

    @if (_loading)
    {
        <div class="d-flex justify-content-center py-5">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />

        </div>
    }
    else if (_association is null)
    {
        <MudAlert Severity="Severity.Error"
                  Variant="Variant.Outlined">

            Föreningen kunde inte hittas.

        </MudAlert>

        <MudButton Variant="Variant.Outlined"
                   Class="mt-3"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="GoBack">

            Tillbaka

        </MudButton>
    }
    else
    {
        <div class="d-flex justify-content-between
                    align-items-center
                    mb-4">

            <div>

                <MudText Typo="Typo.h5">

                    @_association.Name

                </MudText>

                <MudText Typo="Typo.body2"
                         Color="Color.Secondary">

                    Förening

                </MudText>

            </div>


            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="GoBack">

                Tillbaka

            </MudButton>

        </div>


        <MudDivider Class="mb-4" />


        <AssociationMembers AssociationId="AssociationId" />
    }

</div>


@code {

    [Parameter, EditorRequired]
    public Guid AssociationId { get; set; }


    private AssociationListDto ? _association;

    private bool _loading;


    protected override async Task OnParametersSetAsync()
    {
        if (AssociationId == Guid.Empty)
            return;

        await LoadAssociationAsync();
    }


    private async Task LoadAssociationAsync()
    {
        _loading = true;
        _association = null;

        try
        {
            _association = await QuerySender.Send(new GetAssociationQuery(AssociationId));
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);

            _association = null;
        }
        finally
        {
            _loading = false;
        }
    }


    private void GoBack()
    {
        NavigationManager.NavigateTo(
            "/admin/associations");
    }
}