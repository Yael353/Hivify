@page "/admin/dokument"

@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@rendermode InteractiveServer

@using Ansjon.Components.Admin.AdminTabs.AdminDocuments
@using Microsoft.AspNetCore.Authorization
@using MudBlazor

<PageTitle>Hantera dokument</PageTitle>

<AuthorizeView Roles="Admin">

    <Authorized>

        <MudContainer MaxWidth="MaxWidth.Large">

            <MudText Typo="Typo.h5"
                     Color="Color.Primary"
                     Class="font-weight-bold mb-3">

                Hantera dokument

            </MudText>

            <MudText Typo="Typo.body2"
                     Color="Color.Tertiary"
                     Class="mb-4">

                Ladda upp dokument som ska vara tillgängliga
                för användarna.

            </MudText>

            <MudDivider Class="mb-4" />

            <MudGrid>

                <!-- Upload -->

                <MudItem xs="12">

                    <UploadDocument
                        OnDocumentUploaded="RefreshDocuments" />

                </MudItem>


                <!-- Documents -->

                <MudItem xs="12">

                    <MudPaper Class="pa-4"
                              Elevation="2"
                              Style="border-radius: 12px;">

                        <MudText Typo="Typo.subtitle2"
                                 Color="Color.Primary"
                                 Class="font-weight-semibold mb-3">

                            Dokument

                        </MudText>

                        <ListDocuments @ref="_documentList" />

                    </MudPaper>

                </MudItem>

            </MudGrid>

        </MudContainer>

    </Authorized>

    <NotAuthorized>

        <MudAlert Severity="Severity.Error">

            Du har inte behörighet att visa denna sida.

        </MudAlert>

    </NotAuthorized>

</AuthorizeView>

@code {

    private ListDocuments? _documentList;

    private async Task RefreshDocuments()
    {
        if (_documentList is null)
            return;

        await _documentList.Refresh();
    }
}