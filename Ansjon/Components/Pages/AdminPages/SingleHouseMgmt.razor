@page "/admin/hus/{HouseId:guid}"

@layout AdminLayout
@rendermode InteractiveServer

@using Ansjon.Components.Admin.AdminTabs.AdminHouseMgmt.HouseTenants
@using Ansjon.UseCases.Abstractions.Messaging
@using Ansjon.UseCases.Houses.DTOs
@using Ansjon.UseCases.Houses.Queries.GetHouse
@using MudBlazor

@inject IQuerySender QuerySender
@inject NavigationManager NavigationManager

<MudPopoverProvider />
<MudDialogProvider FullWidth="true"
  MaxWidth="MaxWidth.ExtraSmall"
  CloseButton="true"
  BackdropClick="false"
  NoHeader="true"
  Position="DialogPosition.Center"
  CloseOnEscapeKey="true"
  BackgroundClass="my-custom-class"
  ReverseMessageBoxButtonOrder="true" />
<div class="container py-4">

  @if (_loading)
  {
    <div class="d-flex justify-content-center py-5">

      <MudProgressCircular Indeterminate="true"
        Color="Color.Primary" />

    </div>
  }
  else if (_house is null)
  {
    <MudAlert Severity="Severity.Error"
      Variant="Variant.Outlined">

      Huset kunde inte hittas.

    </MudAlert>

    <MudButton Variant="Variant.Outlined"
      Class="mt-3"
      OnClick="GoBack">

      Tillbaka

    </MudButton>
  }
  else
  {
    <div class="d-flex justify-content-between
      align-items-center
      mb-4">

      <div>

        <MudText Typo="Typo.h5">
          @_house.Address
        </MudText>

        <MudText Typo="Typo.body2"
          Color="Color.Secondary">

          Hus

        </MudText>

      </div>


      <MudButton Variant="Variant.Outlined"
        StartIcon="@Icons.Material.Filled.ArrowBack"
        OnClick="GoBack">

        Tillbaka

      </MudButton>

    </div>


    <MudDivider Class="mb-4" />


    <HouseTenants HouseId="HouseId" />
  }

</div>


@code {

  [Parameter, EditorRequired]
  public Guid HouseId { get; set; }

  private HouseListItemDto? _house;

  private bool _loading;


  protected override async Task OnParametersSetAsync()
  {
    if (HouseId == Guid.Empty)
      return;

    await LoadHouseAsync();
  }


  private async Task LoadHouseAsync()
  {
    _loading = true;
    _house = null;

    try
    {
      _house = await QuerySender.Send(
          new GetHouseQuery(HouseId));
    }
    catch (Exception ex)
    {
      Console.Error.WriteLine(ex);

      _house = null;
    }
    finally
    {
      _loading = false;
    }
  }


  private void GoBack()
  {
    NavigationManager.NavigateTo("/admin/hus");
  }
}