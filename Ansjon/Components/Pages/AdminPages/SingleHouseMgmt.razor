@page "/admin/hus/{HouseId:guid}"

@layout AdminLayout
@rendermode InteractiveServer

@using Ansjon.Components.Admin.AdminTabs.AdminHouseMgmt.HouseTenants
@using Ansjon.UseCases.Abstractions.Messaging
@using Ansjon.UseCases.Houses.DTOs
@using Ansjon.UseCases.Houses.Queries.GetHouse

@inject IQuerySender QuerySender
@inject NavigationManager NavigationManager


<MudDialogProvider FullWidth="true"
  MaxWidth="MaxWidth.ExtraSmall"
  CloseButton="true"
  BackdropClick="false"
  NoHeader="true"
  Position="DialogPosition.Center"
  CloseOnEscapeKey="true"
  BackgroundClass="my-custom-class"
  ReverseMessageBoxButtonOrder="true" />
<div class="container py-4">

  @if (_loading)
  {
    <div>
      <p>Laddar hus...</p>
    </div>
  }
  else if (_house is null)
  {
    <div>
      <h2>Huset kunde inte hittas</h2>

      <button type="button"
        class="btn btn-outline-secondary mt-3"
        @onclick="GoBack">
        Tillbaka
      </button>
    </div>
  }
  else
  {
    <div class="d-flex justify-content-between align-items-center mb-4">

      <div>
        <h1 class="h4 mb-1">
          @_house.Address
        </h1>

        <p class="text-muted mb-0">
          Hus
        </p>
      </div>

      <button type="button"
        class="btn btn-outline-secondary"
        @onclick="GoBack">
        Tillbaka
      </button>

    </div>

    <hr class="mb-4" />

    <HouseTenants HouseId="HouseId" />
  }

</div>

@code {

  [Parameter]
  public Guid HouseId { get; set; }

  private HouseListItemDto? _house;
  private bool _loading;
  private Guid _loadedHouseId;

  protected override async Task OnParametersSetAsync()
  {
    if (HouseId == Guid.Empty)
      return;

    if (_loadedHouseId == HouseId)
      return;

    _loadedHouseId = HouseId;

    await LoadHouseAsync();
  }

  private async Task LoadHouseAsync()
  {
    _loading = true;
    _house = null;

    try
    {
      _house = await QuerySender.Send(new GetHouseQuery(HouseId));
    }
    finally
    {
      _loading = false;
    }
  }

  private void GoBack()
  {
    NavigationManager.NavigateTo("/admin/hus");
  }
}