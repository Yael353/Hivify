@page "/admin/hus/{HouseId:guid}"
@layout AdminLayout
@rendermode InteractiveServer

@using Ansjon.Components.Admin.AdminTabs.AdminHouseMgmt
@using Ansjon.UseCases.Abstractions.Messaging
@using Ansjon.UseCases.Houses.DTOs
@using Ansjon.UseCases.Houses.Queries.GetHouse
@using MudBlazor

@inject IQuerySender QuerySender
@inject NavigationManager NavigationManager

<PageTitle>Admin – Hus</PageTitle>

@if (_loading)
{
    <div class="d-flex justify-center pa-6">

        <MudProgressCircular
            Indeterminate="true"
            Color="Color.Primary" />

    </div>
}
else if (_house is null)
{
    <MudAlert Severity="Severity.Error">
        Huset kunde inte hittas.
    </MudAlert>
}
else
{
    <!-- Header -->

    <MudStack Row="true"
              AlignItems="AlignItems.Center"
              Justify="Justify.SpaceBetween"
              Class="mb-4">

        <div>

            <MudText Typo="Typo.h5"
                     Color="Color.Primary"
                     Class="font-weight-bold">

                @_house.Address @_house.HouseNumber

            </MudText>

            <MudText Typo="Typo.body2"
                     Color="Color.Tertiary">

                @_house.PostalCode

            </MudText>

        </div>

        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="GoBack">

            Tillbaka

        </MudButton>

    </MudStack>


    <MudGrid>

        <!-- House -->

        <MudItem xs="12" md="6">

            <AdminHouseDetails
                House="_house"
                OnHouseUpdated="HandleHouseUpdated" />

        </MudItem>


        <!-- Tenants -->

        <MudItem xs="12" md="6">

            <MudPaper Class="pa-4"
                      Elevation="2"
                      Style="border-radius: 12px;">

                <AdminHouseTenants
                    HouseId="HouseId" />

            </MudPaper>

        </MudItem>

    </MudGrid>
}

@code {

    [Parameter]
    public Guid HouseId { get; set; }

    private HouseListItemDto? _house;

    private bool _loading;

    protected override async Task OnParametersSetAsync()
    {
        await LoadHouseAsync();
    }

    private async Task LoadHouseAsync()
    {
        _loading = true;
        _house = null;

        try
        {
            _house = await QuerySender.Send(
                new GetHouseQuery(HouseId));
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleHouseUpdated()
    {
        await LoadHouseAsync();
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/admin/hus");
    }
}