@page "/admin/create-feed"
@using Ansjon.UseCases.Communications.DTO
@using Ansjon.UseCases.Communications.FeedUseCases
@using Ansjon.Models

@inject CreateFeed CreateFeedHandler

<div class="feed-container">
    <h2 class="feed-title">Skapa ny feed</h2>
    <hr class="feed-divider" />

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">
            <strong>Fel:</strong> @errorMessage
        </div>
    }

    <EditForm Model="@NewFeed" OnValidSubmit="@HandleSubmit" FormName="create-feed-form">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="title" class="form-label">Titel</label>
            <InputText id="title" class="form-input" @bind-Value="NewFeed.Title" placeholder="Ange en rubrik..." />
            <ValidationMessage For="@(() => NewFeed.Title)" class="validation-message" />
        </div>

        <div class="form-group">
            <label for="content" class="form-label">Innehåll</label>
            <InputTextArea id="content" class="form-textarea" @bind-Value="NewFeed.Content" placeholder="Skriv ditt innehåll här..." rows="6" />
            <ValidationMessage For="@(() => NewFeed.Content)" class="validation-message" />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit" disabled="@IsSubmitting">
                @(IsSubmitting ? "Sparar..." : "Skicka")
            </button>
        </div>
    </EditForm>

    @if (IsSuccess)
    {
        <div class="alert alert-success mt-3">
            <strong>Feed skapades!</strong>
        </div>
    }
</div>
@code {
    private string? errorMessage;
    private FeedInputModel NewFeed = new();
    private bool IsSubmitting = false;
    private bool IsSuccess = false;
    private async Task HandleSubmit()
    {
        IsSubmitting = true;
        IsSuccess = false;

        try
        {
            var dto = new CreateFeedDto
            {
                Title = NewFeed.Title,
                Content = NewFeed.Content,
            };

            await CreateFeedHandler.CreateFeedAsync(dto);
            IsSuccess = true;
            NewFeed = new();

            
        }
        catch (ArgumentException)
        {
            errorMessage = "Ett oväntat fel uppstod. Försök igen senare.";
        }
        finally
        {
            IsSubmitting = false;
        }

    }

}

