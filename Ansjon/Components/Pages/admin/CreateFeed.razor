@page "/admin/create-feed"
@rendermode InteractiveServer

@using Ansjon.UseCases.Communications.DTO
@using Ansjon.UseCases.Communications.FeedUseCases
@using Ansjon.Models
@using MudBlazor

@inject global::CreateFeed CreateFeedHandler
@inject ISnackbar Snackbar

<MudForm @ref="_form"
         @bind-IsValid="_isValid"
         Model="@NewFeed">

    <MudText Typo="Typo.h4" GutterBottom="true" Class="mb-4">
        Skapa ny feed
    </MudText>

    <MudDivider Class="mb-6" />

    <MudTextField T="string"
                  @bind-Value="NewFeed.Title"
                  Label="Titel"
                  Required="true"
                  RequiredError="Titel är obligatorisk"
                  Immediate="true"
                  Variant="Variant.Outlined"
                  Class="mb-4" />

    <MudTextField T="string"
                  @bind-Value="NewFeed.Content"
                  Label="Innehåll"
                  Required="true"
                  RequiredError="Innehåll är obligatoriskt"
                  Immediate="true"
                  TextArea="true"
                  Lines="5"
                  Variant="Variant.Outlined"
                  Class="mb-6" />

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Disabled="_isSubmitting"
               OnClick="HandleSubmit">

        @if (_isSubmitting)
        {
            <MudProgressCircular Size="Size.Small"
                                 Indeterminate="true"
                                 Class="me-2" />
        }

        @(_isSubmitting ? "Sparar..." : "Skicka")
    </MudButton>

</MudForm>

@code {
    private MudForm? _form;
    private bool _isValid;
    private bool _isSubmitting;

    private FeedInputModel NewFeed { get; set; } = new();

    private async Task HandleSubmit()
    {
        if (_form is null)
            return;

        await _form.Validate();

        if (!_isValid)
            return;

        _isSubmitting = true;

        try
        {
            var dto = new CreateFeedDto
            {
                Title = NewFeed.Title?.Trim(),
                Content = NewFeed.Content?.Trim()
            };

            await CreateFeedHandler.CreateFeedAsync(dto);

            Snackbar.Add("Feed skapades!", Severity.Success);

            NewFeed = new FeedInputModel();

            await _form.ResetAsync();

            StateHasChanged();
        }
        catch (ArgumentException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fel: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}