@page "/admin/feeds"
@rendermode InteractiveServer
@* @attribute [Authorize(Roles = "Admin")]<< kommentera bort när man kan logga in som admin >> *@
@using Ansjon.Core.Entities
@using Ansjon.UseCases.Communications.FeedUseCases
@using Ansjon.UseCases.Communications.DTO.FeedDto
@using MudBlazor
@using Microsoft.AspNetCore.Authorization

@inject ViewFeeds ViewFeeds
@inject UpdateFeed UpdateFeed
@inject DeleteFeed DeleteFeed
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Admin – Hantera feeds</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" Class="mb-2">
    Hantera feeds
</MudText>

<MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mb-4">
    Här kan du se, redigera och ta bort alla feeds.
</MudText>

<MudDivider Class="mb-4" />

@if (_feeds == null)
{
    <MudText>Laddar...</MudText>
}
else if (!_feeds.Any())
{
    <MudText>Inga feeds hittades.</MudText>
}
else
{
    <MudStack Spacing="3">
        @foreach (var feed in _feeds)
        {
            var isEditing = _editingFeedIds.Contains(feed.Id);
            var editModel = GetEditModel(feed);

            <MudCard Elevation="2" Class="pa-4">
                @if (isEditing)
                {
                    <MudCardContent>
                        <MudTextField @bind-Value="editModel.Title" Label="Titel" Variant="Variant.Outlined" Class="mb-3" />
                        <MudTextField @bind-Value="editModel.Content" Label="Innehåll" Variant="Variant.Outlined" Lines="4" Class="mb-3" />
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">
                            Skapad: @feed.CreatedDate.ToString("yyyy-MM-dd HH:mm")
                        </MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Success" OnClick="@(() => SaveFeed(feed.Id, editModel))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Cancel" Color="Color.Default" OnClick="@(() => CancelEdit(feed.Id))" />
                    </MudCardActions>
                }
                else
                {
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">
                            @feed.Title
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mt-1 mb-2">
                            @feed.Content
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">
                            Skapad: @feed.CreatedDate.ToString("yyyy-MM-dd HH:mm")
                        </MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" OnClick="@(() => StartEdit(feed.Id))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteFeedDirect(feed.Id))" />
                    </MudCardActions>
                }
            </MudCard>
        }
    </MudStack>
}

@code {
    private IEnumerable<Feed>? _feeds;
    private HashSet<Guid> _editingFeedIds = new();
    private Dictionary<Guid, EditFeedModel> _editingModels = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadFeeds();
    }

    private async Task LoadFeeds()
    {
        _feeds = await ViewFeeds.GetAllFeedsAsync();
    }

    private void StartEdit(Guid feedId)
    {
        _editingFeedIds.Add(feedId);
        var feed = _feeds!.First(f => f.Id == feedId);
        _editingModels[feedId] = new EditFeedModel
        {
            Title = feed.Title,
            Content = feed.Content
        };
    }

    private void CancelEdit(Guid feedId)
    {
        _editingFeedIds.Remove(feedId);
        _editingModels.Remove(feedId);
    }

    private EditFeedModel GetEditModel(Feed feed)
    {
        return _editingModels.TryGetValue(feed.Id, out var model)
            ? model
            : new EditFeedModel { Title = feed.Title, Content = feed.Content };
    }

    private async Task SaveFeed(Guid feedId, EditFeedModel model)
    {
        try
        {
            var dto = new UpdateFeedDto
            {
                Title = model.Title,
                Content = model.Content
            };

            await UpdateFeed.UpdateFeedAsync(feedId, dto);

            Snackbar.Add("✅ Feeden uppdaterades!", Severity.Success);

            _editingFeedIds.Remove(feedId);
            _editingModels.Remove(feedId);

            await LoadFeeds();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"❌ Fel vid uppdatering: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteFeedDirect(Guid feedId)
    {
        try
        {
            await DeleteFeed.DeleteFeedAsync(feedId);
            Snackbar.Add("🗑️ Feeden togs bort!", Severity.Success);
            await LoadFeeds();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"❌ Fel vid borttagning: {ex.Message}", Severity.Error);
        }
    }

    private class EditFeedModel
    {
        public string Title { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
    }
}