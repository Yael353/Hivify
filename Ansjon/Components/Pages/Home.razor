@page "/"
@using Ansjon.Core.Entities
@using Ansjon.UseCases.Communications.FeedUseCases
@using Ansjon.Components.Feed
@using MudBlazor

@inject ViewFeeds ViewFeeds

<PageTitle>Home</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" Class="mb-4">
    Senaste feeds
</MudText>

<MudDivider Class="mb-4" />

@if (feeds == null)
{
    <MudText>Laddar...</MudText>
}
else if (!feeds.Any())
{
    <MudText>Inga feeds hittades.</MudText>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var feed in feeds)
        {
            <FeedCard Feed="@feed" />
        }
    </div>
}

@code {
    private IEnumerable<Feed>? feeds;

    protected override async Task OnInitializedAsync()
    {
        feeds = await ViewFeeds.GetAllFeedsAsync();
    }
}