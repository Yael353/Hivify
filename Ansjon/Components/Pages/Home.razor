@using Ansjon.UseCases.Communications.FeedUseCases
@using Ansjon.Core.Entities

@page "/"
@inject ViewFeeds ViewFeeds

<PageTitle>Home</PageTitle>

<h3>Feeds</h3>

@if (feeds == null)
{
    <p>Loading...</p>
}
else
{
    <ul>
        @foreach (var feed in feeds)
        {
            <li>
               <h2>@feed.AuthorId</h2>
                <h4>@feed.Title</h4>
                <p>@feed.Content</p>
                <small>@feed.CreatedDate</small>
            </li>
        }
    </ul>
}

@code {
    private IEnumerable<Feed>? feeds;

    protected override async Task OnInitializedAsync()
    {
        feeds = await ViewFeeds.GetAllFeedsAsync();
    }
}