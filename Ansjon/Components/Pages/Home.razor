@page "/"
@attribute [Authorize]

@using Ansjon.Components.User.Home
@using Ansjon.Components.User.UserFeeds
@using Ansjon.UseCases.Abstractions.Messaging
@using Ansjon.UseCases.Feeds.DTOs
@using Ansjon.UseCases.Feeds.Queries.GetFeeds
@using Microsoft.AspNetCore.Authorization

@inject IQuerySender QuerySender

<PageTitle>Hem</PageTitle>

<div class="container py-4">

  <div class="mb-5">
    <UserHero />
  </div>

  <section class="card shadow-sm border-0 rounded-4 mb-5">

    <div class="card-body p-4 p-md-5">

      <div class="d-flex align-items-center justify-content-between mb-3">

        <h5 class="fw-bold text-dark mb-0">
          Senaste nytt
        </h5>

        <span class="text-muted small">
          @_feeds.Count inlägg
        </span>

      </div>

      <hr class="my-3" />

      @if (_loading)
      {
        <div class="text-center py-5">

          <div class="spinner-border text-primary"
            role="status">
          </div>

          <p class="text-muted mt-3 mb-0">
            Laddar feeds...
          </p>

        </div>
      }
      else if (_feeds.Count == 0)
      {
        <div class="text-center py-5">

          <p class="text-muted mb-0">
            Inga feeds ännu.
          </p>

        </div>
      }
      else
      {
        <UserFeedList Feeds="_feeds" />
      }

    </div>

  </section>


  <section class="card shadow-sm border-0 rounded-4">

    <div class="card-body p-4 p-md-5">

      <div class="d-flex align-items-baseline justify-content-between mb-2 flex-wrap gap-2">

        <h5 class="fw-bold text-dark mb-0">
          Ärendehantering
        </h5>

        <span class="text-muted small">
          Något som inte fungerar?
        </span>

      </div>

      <hr class="my-3" />

      <ComplaintComp />

    </div>

  </section>

</div>


@code {

  private IReadOnlyList<FeedListItemDto> _feeds = [];

  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    try
    {
      _feeds = await QuerySender.Send(
          new GetFeedsQuery());
    }
    finally
    {
      _loading = false;
    }
  }
}