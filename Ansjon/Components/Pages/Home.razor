@page "/"
@attribute [Authorize]



@using Ansjon.Components.User.UserFeeds
@using Ansjon.Core.Aggregates.Feeds
@using Ansjon.UseCases.Communications.FeedUseCases
@using Microsoft.AspNetCore.Authorization
@inject ViewFeeds ViewFeeds

<PageTitle>Home</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">
    Senaste feeds
</MudText>

<MudDivider Class="mb-4" />

<UserFeedList Feeds="_feeds" />

@code {

    private IEnumerable<Feed>? _feeds;

    protected override async Task OnInitializedAsync()
    {
        _feeds = await ViewFeeds.GetAllFeedsAsync();
    }

}