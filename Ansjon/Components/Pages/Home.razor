@page "/"


@using Ansjon.Components.User.Feeds
@using Ansjon.UseCases.Communications.FeedUseCases
@using Ansjon.Core.Entities.Feed
@inject ViewFeeds ViewFeeds

<PageTitle>Home</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">
    Senaste feeds
</MudText>

<MudDivider Class="mb-4" />

<FeedList Feeds="_feeds" />

@code {

    private IEnumerable<Feed>? _feeds;

    protected override async Task OnInitializedAsync()
    {
        _feeds = await ViewFeeds.GetAllFeedsAsync();
    }

}