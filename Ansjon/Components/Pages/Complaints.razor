@page "/complaints"
@attribute [Authorize]
@layout MainLayout

@using Ansjon.Components.User.UserComplaints
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Ärendehantering</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="complaints-page">
    
    <div class="complaints-header text-center mb-5">
        <MudText Typo="Typo.h3" Color="Color.Primary" Class="font-weight-bold mb-3">
            Anmälan av Ärenden
        </MudText>
        <MudText Typo="Typo.body1" Color="Color.Dark" Class="mx-auto" Style="max-width: 600px; line-height: 1.7;">
            För vår gemensamma trivsel kan du här tipsa om saker som behöver ses över.
        </MudText>
        <MudDivider Class="my-4" Style="max-width: 80px; margin-left: auto; margin-right: auto;" />
    </div>

    <ComplaintsForm />

    
</MudContainer>

<style>
    .complaints-page {
        padding-top: 2rem;
        padding-bottom: 3rem;
    }

    .complaints-header {
        animation: fadeDown 0.5s ease-out;
    }

    .complaints-footer {
        animation: fadeUp 0.6s ease-out;
    }

    
</style>

@code {
    [CascadingParameter]
    private LayoutComponentBase? Layout { get; set; }

    protected override void OnInitialized()
    {
        Console.WriteLine($"🔍 Layout typ: {Layout?.GetType().Name ?? "Ingen layout!"}");
    }
}