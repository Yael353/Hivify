@if (IsLoading)
{
  <MudProgressCircular Size="Size.Small"
                       Indeterminate="true"
                       Class="me-2" />

  <span>@LoadingText</span>
}
else
{
  <span>@Text</span>
}

@code {
  [Parameter]
  public bool IsLoading { get; set; }

  [Parameter]
  public string Text { get; set; } = string.Empty;

  [Parameter]
  public string LoadingText { get; set; } = "Laddar...";
}