@using Ansjon.Core.Entities
@using MudBlazor


<MudCard Elevation="4">

    <MudCardHeader>

        <CardHeaderContent>

            <MudText Typo="Typo.h6">
                @Feed.Title
            </MudText>

        </CardHeaderContent>

    </MudCardHeader>


    <MudDivider />


    <MudCardContent Class="pa-6">

        <MudText Typo="Typo.body1"
                 Style="white-space:pre-wrap;">

            @Feed.Content

        </MudText>


        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Spacing="1"
                  Class="mt-4">


            <MudIcon Icon="@Icons.Material.Filled.Schedule"
                     Size="Size.Small"
                     Color="Color.Secondary" />


            <MudText Typo="Typo.caption"
                     Color="Color.Secondary">

                @Feed.CreatedDate.ToString("yyyy-MM-dd HH:mm")

            </MudText>


        </MudStack>


    </MudCardContent>


</MudCard>


@code {

    [Parameter]
    public Feed Feed { get; set; } = default!;

}