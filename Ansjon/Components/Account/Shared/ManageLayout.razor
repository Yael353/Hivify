@inherits LayoutComponentBase
@layout Ansjon.Components.Layout.MainLayout

<div class="manage-shell">
    <div class="manage-header">
        <h1 class="mb-1">Manage your account</h1>
        <p class="text-muted mb-0">Change your account settings</p>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-3">
            <div class="manage-card manage-nav-card">
                <ManageNavMenu />
            </div>
        </div>

        <div class="col-12 col-lg-9">
            <div class="manage-card manage-content-card">
                @Body
            </div>
        </div>
    </div>
</div>
