@using Ansjon.Core.Entities
@using MudBlazor

<MudCard Class="mb-4" Elevation="2">
    <MudCardContent>
        
        <MudText Typo="Typo.h5" Class="font-weight-bold">
            @Feed.Title
        </MudText>

@*         <MudText Typo="Typo.caption" Color="Color.Info" Class="mb-2">
            Skapad av: @Feed.AuthorId
        </MudText>  *@

       
        <MudText Typo="Typo.body1" Class="mb-3">
            @Feed.Content
        </MudText>

        <!-- Datum -->
        <MudText Typo="Typo.caption" Color="Color.Tertiary">
            @Feed.CreatedDate.ToString("yyyy-MM-dd HH:mm")
        </MudText>
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public Feed Feed { get; set; } = default!;
}