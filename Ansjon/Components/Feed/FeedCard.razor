@using Ansjon.Core.Entities
@using Ansjon.UseCases.Communications.DTO.FeedDto
@using Ansjon.UseCases.Communications.FeedUseCases
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject UpdateFeed UpdateFeedHandler
@inject DeleteFeed DeleteFeedHandler
@inject ISnackbar Snackbar
@inject ILogger<FeedCard> Logger


<MudCard Elevation="4">

    @if (_editing && ShowAdminActions)
    {
        <AuthorizeView Roles="Admin">

            <Authorized>

                <MudCardContent Class="pa-6">

                    <MudStack Spacing="3">

                        <MudText Typo="Typo.h6">
                            Redigera feed
                        </MudText>


                        <MudTextField Label="Titel"
                                      Variant="Variant.Outlined"
                                      @bind-Value="_updateDto.Title"
                                      Required="true" />


                        <MudTextField Label="Innehåll"
                                      Variant="Variant.Outlined"
                                      TextArea="true"
                                      Lines="5"
                                      @bind-Value="_updateDto.Content" />

                    </MudStack>

                </MudCardContent>


                <MudDivider />


                <MudCardActions Class="pa-4">

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Save"
                               Disabled="_saving"
                               OnClick="SaveAsync">

                        @(_saving ? "Sparar..." : "Spara")

                    </MudButton>


                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Close"
                               Disabled="_saving"
                               OnClick="Cancel">

                        Avbryt

                    </MudButton>

                </MudCardActions>

            </Authorized>

        </AuthorizeView>
    }
    else
    {
        <MudCardHeader>

            <CardHeaderContent>

                <MudText Typo="Typo.h6">
                    @Feed.Title
                </MudText>

            </CardHeaderContent>


            <CardHeaderActions>

                @if (ShowAdminActions)
                {
                    <AuthorizeView Roles="Admin">

                        <Authorized>

                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           OnClick="StartEdit" />


                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           OnClick="DeleteAsync" />

                        </Authorized>

                    </AuthorizeView>
                }

            </CardHeaderActions>

        </MudCardHeader>

        <MudDivider />


        <MudCardContent Class="pa-6">

            <MudText Typo="Typo.body1"
                     Style="white-space:pre-wrap;">

                @Feed.Content

            </MudText>


            <MudStack Row="true"
                      AlignItems="AlignItems.Center"
                      Spacing="1"
                      Class="mt-4">


                <MudIcon Icon="@Icons.Material.Filled.Schedule"
                         Size="Size.Small"
                         Color="Color.Secondary" />


                <MudText Typo="Typo.caption"
                         Color="Color.Secondary">

                    @Feed.CreatedDate.ToString("yyyy-MM-dd HH:mm")

                </MudText>


            </MudStack>


        </MudCardContent>

    }

</MudCard>



@code {

    [Parameter]
    public Feed Feed { get; set; } = default!;


    [Parameter]
    public EventCallback OnChanged { get; set; }


    // Enable only on admin pages
    [Parameter]
    public bool ShowAdminActions { get; set; }



    private UpdateFeedDto _updateDto = new();


    private bool _editing;


    private bool _saving;



    private void StartEdit()
    {
        _updateDto = new UpdateFeedDto
        {
            Title = Feed.Title,
            Content = Feed.Content
        };


        _editing = true;
    }



    private void Cancel()
    {
        _editing = false;

        _updateDto = new UpdateFeedDto();
    }



    private async Task SaveAsync()
    {
        if (_saving)
            return;


        try
        {
            _saving = true;


            _updateDto.Title =
                _updateDto.Title.Trim();


            _updateDto.Content =
                _updateDto.Content.Trim();



            await UpdateFeedHandler.UpdateFeedAsync(
                Feed.Id,
                _updateDto);



            Snackbar.Add(
                "Feed uppdaterades.",
                Severity.Success);



            _editing = false;


            await OnChanged.InvokeAsync();

        }
        catch(Exception ex)
        {
            Logger.LogError(
                ex,
                "Failed updating feed {FeedId}",
                Feed.Id);


            Snackbar.Add(
                "Kunde inte uppdatera feed.",
                Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }



    private async Task DeleteAsync()
    {
        try
        {
            await DeleteFeedHandler.DeleteFeedAsync(
                Feed.Id);



            Snackbar.Add(
                "Feed borttagen.",
                Severity.Success);



            await OnChanged.InvokeAsync();

        }
        catch(Exception ex)
        {
            Logger.LogError(
                ex,
                "Failed deleting feed {FeedId}",
                Feed.Id);


            Snackbar.Add(
                "Kunde inte ta bort feed.",
                Severity.Error);
        }
    }

}