@* @page "/feeds"
@inject ViewFeeds ViewFeeds

<h3>Feeds</h3>

@if (feeds == null)
{
    <p>Loading...</p>
}
else
{
    <ul>
        @foreach (var feed in feeds)
        {
            <li>@feed.Name</li>
        }
    </ul>
}

@code {
    private IEnumerable<Feed>? feeds;

    protected override async Task OnInitializedAsync()
    {
        feeds = await ViewFeeds.ExecuteAsync();
    }
} *@