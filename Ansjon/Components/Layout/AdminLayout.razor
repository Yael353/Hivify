@inherits LayoutComponentBase
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Authorization
@using MudBlazor

<div class="admin-layout">

  <!-- SIDEBAR -->
  <aside class="admin-sidebar">

    <MudPaper Elevation="0"
      Class="admin-sidebar-paper">

      <div class="pa-3">

        <MudText Typo="Typo.h6"
          Color="Color.Primary"
          Class="font-weight-bold mb-3">
          Admin
        </MudText>

        <MudDivider Class="mb-3" />

        <MudNavMenu Rounded="true"
          Margin="Margin.Dense"
          Color="Color.Primary">

          <MudNavLink Href="/admin/nyheter"
            Match="NavLinkMatch.Prefix"
            Icon="@Icons.Material.Filled.Article">
            Nyheter
          </MudNavLink>

          <MudNavLink Href="/admin/hus"
            Match="NavLinkMatch.Prefix"
            Icon="@Icons.Material.Filled.House">
            Hantera hus
          </MudNavLink>

          <MudNavLink Href="/admin/arandehantering"
            Match="NavLinkMatch.Prefix"
            Icon="@Icons.Material.Filled.Report">
            Ärendehantering
          </MudNavLink>

          <MudNavLink Href="/admin/anvandare"
            Match="NavLinkMatch.Prefix"
            Icon="@Icons.Material.Filled.People">
            Användare
          </MudNavLink>

          <MudNavLink Href="/admin/dokument"
            Match="NavLinkMatch.Prefix"
            Icon="@Icons.Material.Filled.Folder">
            Dokument
          </MudNavLink>

        </MudNavMenu>

      </div>

    </MudPaper>

  </aside>


  <!-- PAGE CONTENT -->
  <main class="admin-content">

    @Body

  </main>

</div>