@inherits LayoutComponentBase
@attribute [Authorize(Roles = "Admin")]

@using Ansjon.Components.Layout.Shared
@using Microsoft.AspNetCore.Authorization
@using MudBlazor

<header class="top-row">
    <NavMenu />
</header>

<div class="admin-layout">
    <!-- SIDEBAR – dold på mobil, synlig på desktop -->
    <aside class="admin-sidebar d-none d-md-block" id="adminSidebar">
        <MudPaper Elevation="0" Class="admin-sidebar-paper h-100">
            <div class="pa-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="font-weight-bold">
                        Admin
                    </MudText>
                </div>

                <MudDivider Class="mb-3" />

                <MudNavMenu Rounded="true" Margin="Margin.Dense" Color="Color.Primary">
                    <MudNavLink Href="/admin/nyheter" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Article">
                        Nyheter
                    </MudNavLink>
                    <MudNavLink Href="/admin/hus" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.House">
                        Hantera hus
                    </MudNavLink>
                    <MudNavLink Href="/admin/arandehantering" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Report">
                        Ärendehantering
                    </MudNavLink>
                    <MudNavLink Href="/admin/anvandare" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">
                        Användare
                    </MudNavLink>
                    <MudNavLink Href="/admin/associations" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assignment">
                        Associationer
                    </MudNavLink>
                    <MudNavLink Href="/admin/dokument" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Folder">
                        Dokument
                    </MudNavLink>
                </MudNavMenu>
            </div>
        </MudPaper>
    </aside>

    <!-- HUVUDINNEHÅLL -->
    <main class="admin-content">
        <!-- TOPBAR – synlig på mobil, dold på desktop -->
        <div class="admin-topbar d-md-none">
            <button class="hamburger-btn"
                    onclick="document.getElementById('adminSidebar').classList.toggle('active')">
                ☰
            </button>
            <MudText Typo="Typo.h6" Color="Color.Primary" Class="font-weight-medium">
                Admin
            </MudText>
        </div>

        <!-- FULL BREDD – minimal padding -->
        <div class="admin-body">
            @Body
        </div>
    </main>
</div>

<style>
    /* ===== LAYOUT ===== */
    .admin-layout {
        display: flex;
        min-height: 100vh;
        background: #ffffff;
    }

    /* ===== SIDEBAR ===== */
    .admin-sidebar {
        flex: 0 0 250px;
        background: #ffffff;
        border-right: 1px solid #e8ecf0;
        min-height: 100vh;
        height: 100vh;
        position: sticky;
        top: 0;
        overflow-y: auto;
        transition: transform 0.3s ease;
        z-index: 1000;
    }

        .admin-sidebar.active {
            transform: translateX(0) !important;
        }

    .admin-sidebar-paper {
        height: 100%;
        background: #ffffff;
    }

    /* ===== MAIN CONTENT ===== */
    .admin-content {
        flex: 1;
        min-height: 100vh;
        background: #ffffff;
        display: flex;
        flex-direction: column;
    }

    .admin-body {
        flex: 1;
        padding: 16px;
        max-width: 100%;
        width: 100%;
    }

    /* ===== TOPBAR (mobil) ===== */
    .admin-topbar {
        display: none;
        padding: 12px 16px;
        background: #ffffff;
        border-bottom: 1px solid #e8ecf0;
        align-items: center;
        gap: 12px;
    }

    .hamburger-btn {
        background: none;
        border: none;
        font-size: 1.8rem;
        color: #333;
        cursor: pointer;
        padding: 4px 8px;
        line-height: 1;
    }

        .hamburger-btn:hover {
            color: #3f51b5;
        }

    /* ===== RESPONSIV – MOBIL ===== */
    @@media (max-width: 768px) {
        .admin-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 280px;
            height: 100vh;
            transform: translateX(-100%);
            box-shadow: 2px 0 16px rgba(0, 0, 0, 0.08);
            border-right: 1px solid #e8ecf0;
            z-index: 1050;
            background: #ffffff;
            border-radius: 0;
        }

            .admin-sidebar.active {
                transform: translateX(0);
            }

        .admin-topbar {
            display: flex;
        }

        .admin-body {
            padding: 12px;
        }
    }

    /* ===== RESPONSIV – TABLET ===== */
    @@media (min-width: 769px) and (max-width: 1024px) {
        .admin-sidebar {
            flex: 0 0 220px;
        }
    }

    /* ===== SCROLLBAR ===== */
    .admin-sidebar::-webkit-scrollbar {
        width: 4px;
    }

    .admin-sidebar::-webkit-scrollbar-track {
        background: #f5f5f5;
    }

    .admin-sidebar::-webkit-scrollbar-thumb {
        background: #c5cae9;
        border-radius: 4px;
    }
</style>