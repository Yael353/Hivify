@inherits LayoutComponentBase
@attribute [Authorize(Roles = "Admin")]


@using Microsoft.AspNetCore.Authorization
@using MudBlazor


        @* <NavMenu /> *@
<div class="admin-wrapper">
    <div class="admin-sidebar">

        <!-- Din sidebar här -->
        <MudPaper Width="250px" Elevation="0" Style="min-height: 100vh; border-right: 1px solid #e9edf2;">
            <div class="pa-3">
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="font-weight-bold mb-2">
                    Admin
                </MudText>
                <MudDivider Class="mb-3" />
                
                <MudNavMenu Rounded="true" Margin="Margin.Dense" Color="Color.Primary" Class="pa-1">
                    <MudNavLink Href="/admin/nyheter" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Article">
                        Nyheter
                    </MudNavLink>
                    <MudNavLink Href="/admin/hus" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.House">
                        Hantera hus
                    </MudNavLink>
                    <MudNavLink Href="/admin/arandehantering" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Report">
                        Ärendehantering
                    </MudNavLink>
                    <MudNavLink Href="/admin/anvandare" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">
                        Användare
                    </MudNavLink>
                    <MudNavLink Href="/admin/dokument" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Folder">
                        Dokument
                    </MudNavLink>
                </MudNavMenu>
            </div>
        </MudPaper>
    </div>

    <div class="admin-content">
        <MudThemeProvider />
        <MudPopoverProvider />
        <MudDialogProvider />
        <MudSnackbarProvider />

        <div class="admin-page">
            @Body
        </div>
    </div>
</div>

<style>
    .admin-wrapper {
        display: flex;
        min-height: 100vh;
        background: #f5f7fa;
    }

    .admin-sidebar {
        flex: 0 0 250px;
        background: #ffffff;
        border-right: 1px solid #e9edf2;
        min-height: 100vh;
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
    }

    .admin-content {
        flex: 1;
        padding: 24px 32px;
        background: #f5f7fa;
    }

    .admin-page {
        max-width: 1200px;
        margin: 0 auto;
    }

   
</style>