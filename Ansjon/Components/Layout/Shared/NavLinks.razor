<ul class="navbar-nav me-auto align-items-lg-center">
    <li class="nav-item">
        <NavLink class="nav-link px-lg-3" href="" Match="NavLinkMatch.All">
            Home
        </NavLink>
    </li>

    <AuthorizeView Context="authState">
        <Authorized>
            @if (!authState.User.IsInRole("Admin"))
            {
                <li class="nav-item">
                    <NavLink class="nav-link px-lg-3" href="/complaints" Match="NavLinkMatch.All">
                        Ärendehantering
                    </NavLink>
                </li>
            }
        </Authorized>

        <NotAuthorized>
            <li class="nav-item">
                <NavLink class="nav-link px-lg-3" href="/complaints" Match="NavLinkMatch.All">
                    Ärendehantering
                </NavLink>
            </li>
        </NotAuthorized>
    </AuthorizeView>

    <li class="nav-item">
        <NavLink class="nav-link px-lg-3" href="/kontakt" Match="NavLinkMatch.All">
            Kontakt
        </NavLink>
    </li>
</ul>
