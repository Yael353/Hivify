          <NavLink class="nav-link px-lg-3" href="/complaints">
            Felanmälan
          </NavLink>
        </li>
      }
    </Authorized>

    <NotAuthorized>
      <li class="nav-item">
        <NavLink class="nav-link px-lg-3" href="/complaints">
          Felanmälan
        </NavLink>
      </li>
    </NotAuthorized>
  </AuthorizeView>
</ul>