@using MudBlazor

<div id="@SectionId" class="staff-section">
    <MudText Typo="Typo.h6" Color="Color.Primary" Class="font-weight-bold mb-3">
        @Title
    </MudText>

    <div class="staff-grid">
        @foreach (var person in Staff)
        {
            <div class="staff-card">
                <!-- Avatar / Initialer upptill -->
                <div class="staff-card__top">
                    <div class="staff-card__avatar">
                        @if (!string.IsNullOrEmpty(person.ImageUrl))
                        {
                            <img src="@person.ImageUrl" alt="@person.Name" />
                        }
                        else
                        {
                            <span class="staff-card__initials">@GetInitials(person.Name)</span>
                        }
                    </div>
                </div>

                <!-- Information under -->
                <div class="staff-card__info">
                    <div class="staff-card__name">@person.Name</div>
                    <div class="staff-card__role">@person.Role</div>

                    @if (!string.IsNullOrEmpty(person.Email))
                    {
                        <a class="staff-card__contact" href="mailto:@person.Email">
                            @person.Email
                        </a>
                    }

                    @if (!string.IsNullOrEmpty(person.Phone))
                    {
                        <a class="staff-card__contact" href="tel:@person.Phone">
                            @person.Phone
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>

<style>
    .staff-section {
        margin-bottom: 32px;
    }

    .staff-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 16px;
    }

    .staff-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 16px 12px 14px 12px;
        background: #f8faff;
        border-radius: 14px;
        border: 1px solid #e9edf2;
        transition: background 0.15s ease, transform 0.15s ease;
    }

        .staff-card:hover {
            background: #f0f5fa;
            transform: translateY(-3px);
        }

    /* === Topp: Avatar / Initialer === */
    .staff-card__top {
        margin-bottom: 8px;
    }

    .staff-card__avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #e0e7f0;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        flex-shrink: 0;
        margin: 0 auto;
    }

        .staff-card__avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .staff-card__initials {
        font-size: 1.1rem;
        font-weight: 600;
        color: #3f51b5;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    /* === Info === */
    .staff-card__info {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
    }

    .staff-card__name {
        font-size: 0.95rem;
        font-weight: 500;
        color: #1a1a2e;
    }

    .staff-card__role {
        font-size: 0.75rem;
        color: #6b7084;
        margin-bottom: 4px;
    }

    .staff-card__contact {
        font-size: 0.7rem;
        color: #3f51b5;
        text-decoration: none;
        word-break: break-all;
        transition: color 0.15s ease;
        margin-top: 1px;
    }

        .staff-card__contact:hover {
            color: #1a237e;
            text-decoration: underline;
        }


        .staff-card {
            padding: 12px 10px;
        }

        .staff-card__avatar {
            width: 44px;
            height: 44px;
        }

        .staff-card__initials {
            font-size: 0.9rem;
        }
    }
</style>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? SectionId { get; set; }

    [Parameter]
    public List<StaffMember> Staff { get; set; } = new();

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "?";

        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
            return parts[0].Substring(0, 1).ToUpper();

        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }

    public class StaffMember
    {
        public string Name { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string? Phone { get; set; }
        public string? ImageUrl { get; set; }
    }
}