@using MudBlazor
@inject NavigationManager NavigationManager

<MudPaper Class="pa-5" Elevation="0" Style="border-radius: 20px; border: 1px solid #e9edf2; background: none; transition: all 0.2s ease;">

    <MudText Typo="Typo.h6" Color="Color.Primary" Class="font-weight-bold mb-1">
       Något som behöver åtgärdas?
    </MudText>

    <MudText Typo="Typo.body2" Color="Color.Dark" Class="mb-4" Style="line-height: 1.6;">
        Meddela oss genom att klicka på knappen nedan.
    </MudText>

    <button @onclick="@(() => NavigationManager.NavigateTo("/complaint"))"
            class="btn btn-primary w-100 mt-2">
        Gå till Ärendehantering (HTML-test)
    </button>

    <MudDivider Class="my-4" Style="opacity: 0.4;" />

  
</MudPaper>