@using MudBlazor

<div class="welcome-hero mb-4" style="position: relative; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">
    <div style="
        background-image: url('https://images.pexels.com/photos/32117576/pexels-photo-32117576.jpeg');
        background-size: cover;
        background-position: 70% 57%;
        background-repeat: no-repeat;
        background-color: #2c3e50;
        height: 400px;
        width: 100%;
        position: relative;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        ">
        <div style="
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.1) 100%);
        "></div>

        <div class="align-text-top text-white pt-4" style="position: relative; z-index: 2; padding: 0 20px;">
            <h1 class="display-5 fw-bold mb-2" style="text-shadow: 0 2px 12px rgba(0,0,0,0.3);">
                Här drar vi andan tillsammans
            </h1>
        </div>
    </div>
</div>