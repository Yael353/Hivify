@using Ansjon.Core.SharedKernel.ValuesObjects
@using Ansjon.UseCases.Abstractions.Messaging
@using Ansjon.UseCases.Complaints.Commands.CreateComplaint
@using Ansjon.UseCases.Complaints.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

@inject ISender Sender
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar



<div class="complaint-form-wrapper">
    <MudPaper Class="pa-6" Elevation="2" Style="border-radius: 16px; border: 1px solid #e9edf2;">
        <MudStack Spacing="4">
            <div>
                <MudText Typo="Typo.h5" Color="Color.Primary" Class="font-weight-bold">
                    Anmäl ett ärende
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Dark">
                    Berätta vad som inte fungerar så hjälper vi dig.
                </MudText>
            </div>

            <MudDivider />

            <ComplaintFormFields NewComplaint="NewComplaint" />

            <div class="file-upload-area mb-2">
                <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mb-1">
                    Bifoga bild (valfritt)
                </MudText>
                <InputFile OnChange="@OnFileSelected" accept="image/*" />

                @if (!string.IsNullOrEmpty(NewComplaint.ImageUrl))
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="mt-2">
                        Bild tillagd
                    </MudChip>
                }
            </div>

            @if (!string.IsNullOrEmpty(NewComplaint.ImageUrl))
            {
                <div class="image-preview mt-3">
                    <img src="@NewComplaint.ImageUrl"
                         alt="Bifogad bild"
                         style="max-height: 80px; width: auto; border-radius: 8px; object-fit: cover; border: 1px solid #e9edf2;" />
                    <MudButton Variant="Variant.Text"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="@(() => RemoveImage())"
                               Class="mt-1">
                        Ta bort bild
                    </MudButton>
                </div>
            }

            <MudDivider />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       FullWidth="true"
                       Disabled="@_isSubmitting"
                       OnClick="@(() => HandleSubmit())"
                       Class="submit-btn">
                @if (_isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                    @:Skickar...
                }
                else
                {
                    @:Skicka felanmälan
                }
            </MudButton>

            <button @onclick="@(() => HandleSubmit())" class="btn btn-primary w-100 mt-2">
    Skicka (HTML-test)
</button>
        </MudStack>
    </MudPaper>
</div>

<style>
    .complaint-form-wrapper {
        max-width: 700px;
        margin: 0 auto;
    }

    .file-upload-area {
        padding: 8px 0;
    }

    .image-preview {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .submit-btn:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(63, 81, 181, 0.3);
    }
</style>

@code
{
    private readonly CreateComplaintDto NewComplaint = new();
    private bool _isSubmitting;

    private async Task HandleSubmit()
    {
        Console.WriteLine("🔍 1. HandleSubmit startar!");
        _isSubmitting = true;
        StateHasChanged();

        try
        {
            Console.WriteLine("🔍 2. Hämtar authState...");
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (!user.Identity?.IsAuthenticated ?? true)
            {
                Console.WriteLine("❌ 3. Användaren är inte inloggad!");
                Snackbar.Add("Du måste vara inloggad för att skicka in felanmälan.", Severity.Warning);
                return;
            }
            Console.WriteLine("✅ 3. Användaren är inloggad.");

            Console.WriteLine($"🔍 4. Skapar kommando: {NewComplaint.Title}");
            var command = new CreateComplaintCommand(
                NewComplaint.Category,
                NewComplaint.Title,
                NewComplaint.Description,
                NewComplaint.ImageUrl
            );

            Console.WriteLine("🔍 5. Skickar kommando via Sender...");
            await Sender.Send(command);
            Console.WriteLine("✅ 6. Kommando skickat!");

            Snackbar.Add("Felanmälan skickades!", Severity.Success);
            ResetForm();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ FEL: {ex.Message}");
            Console.WriteLine($"❌ INNER EXCEPTION: {ex.InnerException?.Message}");
            Console.WriteLine($"Stacktrace: {ex.StackTrace}");
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
            Console.WriteLine("🔍 7. HandleSubmit avslutas");
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        try
        {
            using var stream = file.OpenReadStream(2 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);

            NewComplaint.ImageUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}";
            Snackbar.Add("Bild tillagd.", Severity.Info);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Kunde inte ladda bild: {ex.Message}", Severity.Error);
        }
    }

    private Task RemoveImage()
    {
        NewComplaint.ImageUrl = null;
        Snackbar.Add("Bild borttagen.", Severity.Info);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void ResetForm()
    {
        NewComplaint.Title = string.Empty;
        NewComplaint.Description = string.Empty;
        NewComplaint.ImageUrl = null;
        NewComplaint.Category = ComplaintCategory.Väg;
    }
}