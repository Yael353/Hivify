@using Ansjon.Core.Aggregates.Complaints
@using Ansjon.Core.Aggregates.Houses.Tenants
@using Ansjon.UseCases.Communications.ComplaintUseCases
@using Ansjon.UseCases.Communications.DTOs.ComplaintsDto
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms

@inject CreateComplaint CreateComplaintHandler
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar

<MudGrid GutterSize="4" Class="complaint-form-grid">
  <MudItem xs="12" md="7">
    <MudPaper Class="pa-4 pa-md-5 complaint-form__panel"
              Elevation="0"
              Variant="Variant.Outlined">
      <MudStack Spacing="3">
        <ComplaintFormFields NewComplaint="NewComplaint" />
        <ComplaintFileUpload ImageUrl="NewComplaint.ImageUrl"
                             OnFileSelected="OnFileSelected"
                             OnRemoveImage="RemoveImage"
                             IsSubmitting="_isSubmitting" />

        <MudPaper Class="pa-4 complaint-form__submit-panel"
                  Elevation="0"
                  Variant="Variant.Outlined">
          <ComplaintSubmitButton IsSubmitting="_isSubmitting"
                                 OnSubmit="HandleSubmit" />
        </MudPaper>
      </MudStack>
    </MudPaper>
  </MudItem>
</MudGrid>

@code
{
  #region State

  private readonly CreateComplaintDto NewComplaint = new();

  private bool _isSubmitting;

  #endregion

  #region Submit

  private async Task HandleSubmit()
  {
    _isSubmitting = true;

    try
    {
      var authState = await AuthProvider.GetAuthenticationStateAsync();
      var user = authState.User;

      if (!user.Identity?.IsAuthenticated ?? true)
      {
        Snackbar.Add("Du måste vara inloggad för att skicka in felanmälan.", Severity.Warning);
        return;
      }

      var tenantIdClaim = user.FindFirst("TenantId")?.Value;

      if (string.IsNullOrWhiteSpace(tenantIdClaim))
      {
        Snackbar.Add("TenantId kunde inte hittas.", Severity.Error);
        return;
      }

      TenantID tenantId = new TenantID(Guid.Parse(tenantIdClaim));
      
      
      await CreateComplaintHandler.CreateComplaintAsync(NewComplaint, tenantId);

      Snackbar.Add("Felanmälan skickades!", Severity.Success);

      
    }
    catch (Exception ex)
    {
      Snackbar.Add($"Fel: {ex.Message}", Severity.Error);
    }
    finally
    {
      _isSubmitting = false;
    }
  }
  #endregion

  #region File Upload

  private async Task OnFileSelected(IBrowserFile file)
  {
    if (file is null)
      return;

    using var stream = file.OpenReadStream(2 * 1024 * 1024);
    using var memory = new MemoryStream();

    await stream.CopyToAsync(memory);

    NewComplaint.ImageUrl =
        $"data:{file.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}";

    Snackbar.Add("Bild tillagd!", Severity.Info);
  }

  private Task RemoveImage()
  {
    NewComplaint.ImageUrl = null;

    Snackbar.Add(
        "Bild borttagen.",
        Severity.Info);

    return Task.CompletedTask;
  }

  #endregion

  #region Helpers

  private async Task<bool> IsUserAuthenticated()
  {
    var authState = await AuthProvider.GetAuthenticationStateAsync();

    if (authState.User.Identity?.IsAuthenticated == true)
      return true;

    Snackbar.Add(
        "Du måste vara inloggad för att skicka in felanmälan.",
        Severity.Warning);

    return false;
  }

  private void ResetForm()
  {
    NewComplaint.Title = string.Empty;
    NewComplaint.Description = string.Empty;
    NewComplaint.ImageUrl = null;
  }

  #endregion

}