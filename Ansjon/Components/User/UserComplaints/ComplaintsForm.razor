@using Ansjon.UseCases.Communications.ComplaintUseCases
@using Ansjon.UseCases.Communications.DTOs.ComplaintsDto
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject CreateComplaint CreateComplaintHandler
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar

<MudGrid GutterSize="4" Class="complaint-form-grid">
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4 pa-md-5 complaint-form__panel" Elevation="0" Variant="Variant.Outlined">
            <MudStack Spacing="3">
           

                <ComplaintFormFields NewComplaint="@NewComplaint" />
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="5">
        <MudStack Spacing="3">
            <ComplaintFileUpload ImageUrl="@NewComplaint.ImageUrl"
                                 OnFileSelected="@OnFileSelected"
                                 OnRemoveImage="@RemoveImage"
                                 IsSubmitting="@_isSubmitting" />

            <MudPaper Class="pa-4 pa-md-5 complaint-form__submit-panel" Elevation="0" Variant="Variant.Outlined">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6" Class="font-weight-bold">
                        Skicka in
                    </MudText>
            
                    <ComplaintSubmitButton IsSubmitting="@_isSubmitting"
                                           OnSubmit="@HandleSubmit" />
                </MudStack>
            </MudPaper>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private CreateComplaintDto NewComplaint = new();
    private bool _isSubmitting = false;

    private async Task HandleSubmit()
    {
        _isSubmitting = true;

        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(userId))
            {
                Snackbar.Add("Du måste vara inloggad för att skicka in felanmälan.", Severity.Warning);
                _isSubmitting = false;
                return;
            }

            NewComplaint.AuthorId = Guid.Parse(userId);

            await CreateComplaintHandler.CreateComplaintAsync(NewComplaint);

            Snackbar.Add("Felanmälan skickades!", Severity.Success);

            NewComplaint = new CreateComplaintDto();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"❌ Fel: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task OnFileSelected(IBrowserFile file)
    {
        if (file is null) return;
        using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        var bytes = memoryStream.ToArray();
        NewComplaint.ImageUrl = $"data:image/png;base64,{Convert.ToBase64String(bytes)}";

        Snackbar.Add("Bild tillagd!", Severity.Info);
    }

    private Task RemoveImage()
    {
        NewComplaint.ImageUrl = null;
        Snackbar.Add("Bild borttagen.", Severity.Info);
        return Task.CompletedTask;
    }
}
