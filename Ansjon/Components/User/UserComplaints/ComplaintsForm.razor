@using Ansjon.Core.Aggregates.Complaints
@using Ansjon.Core.Aggregates.Houses.Tenants
@using Ansjon.UseCases.Complaints
@using Ansjon.UseCases.Complaints.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

@inject CreateComplaint CreateComplaintHandler
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar

<div class="complaint-form-wrapper">
    <MudPaper Class="pa-6" Elevation="2" Style="border-radius: 16px; border: 1px solid #e9edf2;">
        <MudStack Spacing="4">
            <!-- Rubrik -->
            <div>
                <MudText Typo="Typo.h5" Color="Color.Primary" Class="font-weight-bold">
                    Anmäl ett ärende
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Dark">
                    Berätta vad som inte fungerar så hjälper vi dig.
                </MudText>
            </div>

            <MudDivider />

            <!-- Formulärfält -->
            <MudTextField @bind-Value="NewComplaint.Title"
                          Label="Titel"
                          Placeholder="Ange en kort rubrik..."
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Titel är obligatorisk"
                          Immediate="true"
                          Class="mb-2" />

            <MudTextField @bind-Value="NewComplaint.Description"
                          Label="Beskrivning"
                          Placeholder="Beskriv problemet i detalj..."
                          Variant="Variant.Outlined"
                          Lines="5"
                          Required="true"
                          RequiredError="Beskrivning är obligatorisk"
                          Immediate="true"
                          Class="mb-2" />

            <!-- Filuppladdning -->
            <div class="file-upload-area mb-2">
                <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mb-1">
                    Bifoga bild (valfritt)
                </MudText>
                <InputFile OnChange="@OnFileSelected" accept="image/*" />

                @if (!string.IsNullOrEmpty(NewComplaint.ImageUrl))
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="mt-2">
                        Bild tillagd
                    </MudChip>
                }
            </div>

            <!-- Miniatyr av bilden -->
            @if (!string.IsNullOrEmpty(NewComplaint.ImageUrl))
            {
                <div class="image-preview mt-3">
                    <img src="@NewComplaint.ImageUrl"
                         alt="Bifogad bild"
                         style="max-height: 80px; width: auto; border-radius: 8px; object-fit: cover; border: 1px solid #e9edf2;" />

                    <MudButton Variant="Variant.Text"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="@(() => RemoveImage())"
                               Class="mt-1">
                        Ta bort bild
                    </MudButton>
                </div>
            }

            <MudDivider />

            <!-- Skicka-knapp -->
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       FullWidth="true"
                       Disabled="@_isSubmitting"
                       OnClick="@(() => HandleSubmit())"
                       Class="submit-btn">
                @if (_isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                    @:Skickar...
                }
                else
                {
                    @:Skicka felanmälan
                }
            </MudButton>
        </MudStack>
    </MudPaper>
</div>

<style>
    .complaint-form-wrapper {
        max-width: 700px;
        margin: 0 auto;
    }

    .file-upload-area {
        padding: 8px 0;
    }

    .image-preview {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .submit-btn {
        transition: all 0.2s ease;
    }

        .submit-btn:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(63, 81, 181, 0.3);
        }
</style>

@code
{
    #region State

    private readonly CreateComplaintDto NewComplaint = new();
    private bool _isSubmitting;

    #endregion

    #region Submit

    private async Task HandleSubmit()
    {
        _isSubmitting = true;

        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (!user.Identity?.IsAuthenticated ?? true)
            {
                Snackbar.Add("Du måste vara inloggad för att skicka in felanmälan.", Severity.Warning);
                return;
            }

            var tenantIdClaim = user.FindFirst("TenantId")?.Value;

            if (string.IsNullOrWhiteSpace(tenantIdClaim))
            {
                Snackbar.Add("Boende kunde inte hittas.", Severity.Error);
                return;
            }

            var tenantId = new TenantID(Guid.Parse(tenantIdClaim));

            await CreateComplaintHandler.CreateComplaintAsync(NewComplaint, tenantId);

            Snackbar.Add("Felanmälan skickades!", Severity.Success);

            ResetForm();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fel: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    #endregion

    #region File Upload

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
            return;

        try
        {
            using var stream = file.OpenReadStream(2 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);

            NewComplaint.ImageUrl =
                $"data:{file.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}";

            Snackbar.Add("Bild tillagd.", Severity.Info);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Kunde inte ladda bild: {ex.Message}", Severity.Error);
        }
    }

    private Task RemoveImage()
    {
        NewComplaint.ImageUrl = null;
        Snackbar.Add("Bild borttagen.", Severity.Info);
        StateHasChanged();
        return Task.CompletedTask;
    }

    #endregion

    #region Helpers

    private void ResetForm()
    {
        NewComplaint.Title = string.Empty;
        NewComplaint.Description = string.Empty;
        NewComplaint.ImageUrl = null;
    }

    #endregion

}