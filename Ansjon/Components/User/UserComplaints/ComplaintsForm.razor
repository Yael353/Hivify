@using Ansjon.UseCases.Communications.ComplaintUseCases
@using Ansjon.UseCases.Communications.DTOs.ComplaintsDto
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject CreateComplaint CreateComplaintHandler
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar

<MudPaper Class="pa-4" Elevation="2" Style="border-radius: 12px;">
   

    <MudDivider Class="mb-3" />

    <ComplaintFormFields NewComplaint="@NewComplaint" />

    <ComplaintFileUpload ImageUrl="@NewComplaint.ImageUrl"
                         OnFileSelected="@OnFileSelected"
                         OnRemoveImage="@RemoveImage"
                         IsSubmitting="@_isSubmitting" />

    <ComplaintSubmitButton IsSubmitting="@_isSubmitting"
                           OnSubmit="@HandleSubmit" />
</MudPaper>

@code {
    private CreateComplaintDto NewComplaint = new();
    private bool _isSubmitting = false;

    private async Task HandleSubmit()
    {
        _isSubmitting = true;

        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(userId))
            {
                Snackbar.Add("Du måste vara inloggad för att skicka in felanmälan.", Severity.Warning);
                _isSubmitting = false;
                return;
            }

            NewComplaint.AuthorId = Guid.Parse(userId);

            await CreateComplaintHandler.CreateComplaintAsync(NewComplaint);

            Snackbar.Add("Felanmälan skickades!", Severity.Success);

            NewComplaint = new CreateComplaintDto();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"❌ Fel: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task OnFileSelected(IBrowserFile file)
    {
        using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        var bytes = memoryStream.ToArray();
        NewComplaint.ImageUrl = $"data:image/png;base64,{Convert.ToBase64String(bytes)}";

        Snackbar.Add("Bild tillagd!", Severity.Info);
    }

    private Task RemoveImage()
    {
        NewComplaint.ImageUrl = null;
        Snackbar.Add("Bild borttagen.", Severity.Info);
        return Task.CompletedTask;
    }
}
