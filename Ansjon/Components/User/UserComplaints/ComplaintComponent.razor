@page "/complaint"
@attribute [Authorize]
@rendermode InteractiveServer

@using Ansjon.Core.SharedKernel.ValuesObjects
@using Ansjon.UseCases.Abstractions.Messaging
@using Ansjon.UseCases.Complaints.Commands.CreateComplaint
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

@inject ISender Sender
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar

<PageTitle>Ny felanmälan</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-4">
    <MudPaper Class="pa-6" Elevation="3" Style="border-radius: 16px;">
        <MudText Typo="Typo.h5" Color="Color.Primary" Class="font-weight-bold mb-3">
            Skicka in en felanmälan
        </MudText>

        <MudDivider Class="mb-4" />

        <MudStack Spacing="3">
            <!-- Kategori -->
            <div>
                <label style="display: block; margin-bottom: 4px; font-weight: 500;">
                    Kategori
                </label>
                <select @bind="_category" style="width: 100%; padding: 12px; border-radius: 8px; border: 1px solid #d9d9d9; font-size: 16px;">
                    <option value="@ComplaintCategory.Väg">Väg</option>
                    <option value="@ComplaintCategory.Vatten">Vatten</option>
                    <option value="@ComplaintCategory.Trivsel">Trivsel</option>
                    <option value="@ComplaintCategory.BryggaOchFörråd">Brygga & Förråd</option>
                </select>
            </div>

            <!-- Titel -->
            <MudTextField @bind-Value="_title"
                          Label="Titel"
                          Placeholder="Kort rubrik..."
                          Variant="Variant.Outlined"
                          FullWidth="true" />

            <!-- Beskrivning -->
            <MudTextField @bind-Value="_description"
                          Label="Beskrivning"
                          Placeholder="Vad har hänt?"
                          Variant="Variant.Outlined"
                          Lines="4"
                          TextArea="true"
                          FullWidth="true" />

            <!-- ⭐ BILDUPLADDNING – med InputFile -->
            <div>
                <label style="display: block; margin-bottom: 4px; font-weight: 500;">
                    Bifoga bild (valfritt)
                </label>
                <InputFile OnChange="@OnFileSelected" accept="image/*" capture="environment" />

                @if (!string.IsNullOrEmpty(_imageUrl))
                {
                    <div style="margin-top: 8px;">
                        <img src="@_imageUrl" alt="Bifogad bild" style="max-height: 80px; border-radius: 8px; border: 1px solid #e9edf2;" />
                        <button @onclick="RemoveImage" style="display: block; padding: 0; margin-top: 4px; background: none; border: none; color: #dc3545; cursor: pointer;">
                            Ta bort bild
                        </button>
                    </div>
                }
            </div>

            <!-- Skicka-knapp -->
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       FullWidth="true"
                       Disabled="_isSubmitting"
                       OnClick="@(() => HandleSubmit())">
                @if (_isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                    @:Skickar...
                }
                else
                {
                    @:Skicka felanmälan
                }
            </MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private ComplaintCategory _category = ComplaintCategory.Väg;
    private string _title = string.Empty;
    private string _description = string.Empty;
    private string? _imageUrl = null;
    private bool _isSubmitting = false;

    private async Task HandleSubmit()
    {
        Console.WriteLine("🔍 1. HandleSubmit startar!");

        if (string.IsNullOrWhiteSpace(_title))
        {
            Snackbar.Add("Titel är obligatorisk!", Severity.Warning);
            return;
        }

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            Console.WriteLine("🔍 2. Hämtar användare...");
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (!user.Identity?.IsAuthenticated ?? true)
            {
                Snackbar.Add("Du måste vara inloggad.", Severity.Warning);
                return;
            }

            Console.WriteLine("🔍 3. Skapar kommando...");
            var command = new CreateComplaintCommand(
                _category,
                _title,
                _description,
                _imageUrl
            );

            Console.WriteLine("🔍 4. Skickar kommando...");
            await Sender.Send(command);

            Console.WriteLine("✅ 5. Klart!");
            Snackbar.Add("Felanmälan skickades!", Severity.Success);

            _title = string.Empty;
            _description = string.Empty;
            _imageUrl = null;
            _category = ComplaintCategory.Väg;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ FEL: {ex.Message}");
            Snackbar.Add($"Fel: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        try
        {
            using var stream = file.OpenReadStream(2 * 1024 * 1024);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);

            _imageUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}";
            StateHasChanged();

            Snackbar.Add("Bild tillagd!", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Kunde inte ladda bild: {ex.Message}", Severity.Error);
        }
    }

    private void RemoveImage()
    {
        _imageUrl = null;
        StateHasChanged();
        Snackbar.Add("Bild borttagen.", Severity.Info);
    }
}