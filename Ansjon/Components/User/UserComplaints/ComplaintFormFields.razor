@using Ansjon.UseCases.Communications.DTOs.ComplaintsDto

<MudStack Spacing="3" Class="complaint-form-fields">
		<MudTextField @bind-Value="NewComplaint.Title"
									Label="Titel"
									Placeholder="Kort sammanfattning av felet"
									Variant="Variant.Outlined"
									Required="true"
									RequiredError="Titel krävs"
									FullWidth="true" />

		<MudTextField @bind-Value="NewComplaint.Description"
									Label="Beskrivning"
									Placeholder="Beskriv vad som har hänt, när det började och vad som påverkas"
									Variant="Variant.Outlined"
									Lines="8"
									FullWidth="true" />
</MudStack>

@code {
		[Parameter]
		public CreateComplaintDto NewComplaint { get; set; } = new();
}
