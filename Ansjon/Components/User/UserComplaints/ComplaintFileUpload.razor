@using Microsoft.AspNetCore.Components.Forms

<MudPaper Variant="Variant.Outlined" Class="pa-4 complaint-upload-card">
		<MudStack Spacing="2">
				<MudStack Spacing="1">
						<MudText Typo="Typo.h6" Class="font-weight-bold">
								Bifoga bild
						</MudText>
					
				</MudStack>

				<MudFileUpload T="string"
											 Label="Bifoga bild (valfritt)"
											 Variant="Variant.Text"
											 Accept="image/*"
											 OnChanged="HandleChanged">
						<ButtonTemplate>
								<MudStack Spacing="1">
										<MudButton Variant="Variant.Outlined"
															 Color="Color.Primary"
															 StartIcon="@Icons.Material.Filled.AttachFile"
															 Disabled="@IsSubmitting"
															 FullWidth="true">
												Välj bild
										</MudButton>
										@if (!string.IsNullOrEmpty(ImageUrl))
										{
												<MudChip T="string" Color="Color.Success" Size="Size.Small" Class="align-self-start">
														Bild tillagd
												</MudChip>
										}
								</MudStack>
						</ButtonTemplate>
				</MudFileUpload>

				@if (!string.IsNullOrEmpty(ImageUrl))
				{
						<MudPaper Class="complaint-upload-preview" Variant="Variant.Outlined">
								<MudCardMedia Image="@ImageUrl" Alt="Bifogad bild" />
								<MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-3 complaint-upload-preview__actions">
										<MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
												Bild förhandsvisad
										</MudChip>
										<MudButton Variant="Variant.Text"
															 Color="Color.Error"
															 Size="Size.Small"
															 StartIcon="@Icons.Material.Filled.Close"
															 OnClick="@(()=> OnRemoveImage.InvokeAsync())">
												Ta bort bild
										</MudButton>
								</MudStack>
						</MudPaper>
				}
				else
				{
						<MudPaper Class="pa-3 complaint-upload-empty" Elevation="0">
								<MudText Typo="Typo.body2" Color="Color.Secondary">
										Ingen bild har valts ännu.
								</MudText>
						</MudPaper>
				}
		</MudStack>
</MudPaper>

@code {
		[Parameter]
		public string ImageUrl { get; set; }

		[Parameter]
		public EventCallback<IBrowserFile> OnFileSelected { get; set; }

		[Parameter]
		public EventCallback OnRemoveImage { get; set; }

		[Parameter]
		public bool IsSubmitting { get; set; }

		private Task HandleChanged(IBrowserFile file)
		{
				return OnFileSelected.InvokeAsync(file);
		}
}
