@using Microsoft.AspNetCore.Components.Forms

<MudFileUpload T="string"
							 Label="Bifoga bild (valfritt)"
							 Variant="Variant.Outlined"
							 Accept="image/*"
							 Class="mb-3"
							 OnChanged="HandleChanged">
		<ButtonTemplate>
				<MudButton Variant="Variant.Outlined"
									 Color="Color.Primary"
									 StartIcon="@Icons.Material.Filled.AttachFile"
									 Disabled="@IsSubmitting">
						Välj bild...
				</MudButton>
				@if (!string.IsNullOrEmpty(ImageUrl))
				{
						<MudChip T="string" Color="Color.Success" Size="Size.Small" Class="ml-2">
								✅ Bild tillagd
						</MudChip>
				}
		</ButtonTemplate>
</MudFileUpload>

@if (!string.IsNullOrEmpty(ImageUrl))
{
		<MudImage Src="@ImageUrl"
							Alt="Bifogad bild"
							Elevation="2"
							Class="mb-3"
							Style="max-height: 150px; width: auto; border-radius: 8px;" />
		<MudButton Variant="Variant.Text"
							 Color="Color.Error"
							 Size="Size.Small"
							 OnClick="@(()=> OnRemoveImage.InvokeAsync())">
				<MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" /> Ta bort bild
		</MudButton>
}

@code {
		[Parameter]
		public string ImageUrl { get; set; }

		[Parameter]
		public EventCallback<IBrowserFile> OnFileSelected { get; set; }

		[Parameter]
		public EventCallback OnRemoveImage { get; set; }

		[Parameter]
		public bool IsSubmitting { get; set; }

		private Task HandleChanged(IBrowserFile file)
		{
				return OnFileSelected.InvokeAsync(file);
		}
}
