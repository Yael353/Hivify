@using Ansjon.UseCases.Communications.ComplaintUseCases
@using Ansjon.UseCases.Communications.DTOs.ComplaintsDto
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject CreateComplaint CreateComplaintHandler
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar

<MudPaper Class="pa-4" Elevation="2" Style="border-radius: 12px;">
    <MudText Typo="Typo.h6" GutterBottom="true" Color="Color.Primary">
        🛠️ Skicka felanmälan
    </MudText>

    <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mb-3">
        Här kan du rapportera tekniska problem eller andra fel som uppstår i communityn.
    </MudText>

    <MudDivider Class="mb-3" />

    
    <MudTextField @bind-Value="NewComplaint.Title"
                  Label="Titel"
                  Variant="Variant.Outlined"
                  Class="mb-3" />

   
    <MudTextField @bind-Value="NewComplaint.Description"
                  Label="Beskrivning"
                  Variant="Variant.Outlined"
                  Lines="4"
                  Class="mb-3" />

    
    <MudFileUpload T="string" 
                   Label="Bifoga bild (valfritt)"
                   Variant="Variant.Outlined"
                   Accept="image/*"
                   Class="mb-3"
                   OnChanged="@OnFileSelected">
        <ButtonTemplate>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AttachFile"
                       Disabled="@_isSubmitting">
                Välj bild...
            </MudButton>
            @if (!string.IsNullOrEmpty(NewComplaint.ImageUrl))
            {
                <MudChip T="string" Color =" Color.Success" Size="Size.Small" Class="ml-2">
                    ✅ Bild tillagd
                </MudChip>
            }
        </ButtonTemplate>
    </MudFileUpload>

    
    @if (!string.IsNullOrEmpty(NewComplaint.ImageUrl))
    {
        <MudImage Src="@NewComplaint.ImageUrl" 
                  Alt="Bifogad bild"
                  Elevation="2"
                  Class="mb-3"
                  Style="max-height: 150px; width: auto; border-radius: 8px;" />
        <MudButton Variant="Variant.Text"
                   Color="Color.Error"
                   Size="Size.Small"
                   OnClick="@(() => RemoveImage())">
            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" /> Ta bort bild
        </MudButton>
    }

    
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Disabled="@_isSubmitting"
               OnClick="@(() => HandleSubmit())"
               FullWidth="true"
               Size="Size.Large"
               Class="mt-2">
        @if (_isSubmitting)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
        }
        @(_isSubmitting ? "Skickar..." : "Skicka felanmälan")
    </MudButton>
</MudPaper>

@code {
    private CreateComplaintDto NewComplaint = new();
    private bool _isSubmitting = false;

    private async Task HandleSubmit()
    {
        _isSubmitting = true;

        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(userId))
            {
                Snackbar.Add("Du måste vara inloggad för att skicka in felanmälan.", Severity.Warning);
                return;
            }

            NewComplaint.AuthorId = Guid.Parse(userId);

            await CreateComplaintHandler.CreateComplaintAsync(NewComplaint);

            Snackbar.Add("Felanmälan skickades!", Severity.Success);

            NewComplaint = new CreateComplaintDto();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"❌ Fel: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void OnFileSelected(IBrowserFile file)
    {
        
        using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
        using var memoryStream = new MemoryStream();
        stream.CopyTo(memoryStream);
        var bytes = memoryStream.ToArray();
        NewComplaint.ImageUrl = $"data:image/png;base64,{Convert.ToBase64String(bytes)}";
        
        Snackbar.Add("Bild tillagd!", Severity.Info);
    }

    private void RemoveImage()
    {
        NewComplaint.ImageUrl = null;
        Snackbar.Add("Bild borttagen.", Severity.Info);
    }
}