@using Ansjon.Core.Aggregates.Feeds
@using Ansjon.UseCases.Feeds.DTOs

<div class="card feed-card mb-4 shadow-sm" style="border-radius: 12px; border-left: 4px solid #3f51b5; transition: all 0.2s ease;">
    <div class="card-header bg-transparent border-0 pb-0">
        <h5 class="card-title text-dark fw-bold mb-0">
            @Feed.Title
        </h5>
    </div>

    <div class="card-body pt-2">
        <p class="card-text text-primary" style="white-space: pre-wrap; line-height: 1.6;">
            @Feed.Content
        </p>

        <div class="d-flex align-items-center mt-3">
            <small class="text-secondary">
                @Feed.CreatedDate.ToString("dd MMM yyyy, HH:mm")
            </small>
        </div>
    </div>
</div>

<style>
    .feed-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.10) !important;
    }
</style>

@code {
  [Parameter, EditorRequired]
  public FeedListItemDto Feed { get; set; } = default!;
}