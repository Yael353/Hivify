@* @using Ansjon.Components.Admin.AdminTabs.AdminFeedsMgmt;
@using Ansjon.Components.Admin.AdminTabs.AdminHouseMgmt
@using Ansjon.Components.Admin.AdminTabs.AdminUserMgmt
@using MudBlazor

<MudGrid>
    <!-- Sidebar -->
    <MudItem xs="12" md="3" lg="2">
        <MudPaper Width="250px" Elevation="0" Class="pa-2">
            <MudStack Spacing="1">
                
                <MudButton Variant="Variant.Text"
                           Color="@(ActiveTab == "feeds" ? Color.Primary : Color.Default)"
                           StartIcon="@Icons.Material.Filled.Article"
                           FullWidth="true"
                           OnClick="@(() => SetActiveTab("feeds"))"
                           Style="justify-content: flex-start; padding: 10px 16px; border-radius: 8px;">
                    Nyheter
                </MudButton>

                <MudButton Variant="Variant.Text"
                           Color="@(ActiveTab == "houses" ? Color.Primary : Color.Default)"
                           StartIcon="@Icons.Material.Filled.House"
                           FullWidth="true"
                           OnClick="@(() => SetActiveTab("houses"))"
                           Style="justify-content: flex-start; padding: 10px 16px; border-radius: 8px;">
                    Hus
                </MudButton>

                <MudButton Variant="Variant.Text"
                           Color="@(ActiveTab == "complaints" ? Color.Primary : Color.Default)"
                           StartIcon="@Icons.Material.Filled.Report"
                           FullWidth="true"
                           OnClick="@(() => SetActiveTab("complaints"))"
                           Style="justify-content: flex-start; padding: 10px 16px; border-radius: 8px;">
                    Ärendehantering
                </MudButton>

                <MudButton Variant="Variant.Text"
                           Color="@(ActiveTab == "users" ? Color.Primary : Color.Default)"
                           StartIcon="@Icons.Material.Filled.People"
                           FullWidth="true"
                           OnClick="@(() => SetActiveTab("users"))"
                           Style="justify-content: flex-start; padding: 10px 16px; border-radius: 8px;">
                    Användare
                </MudButton>

                <MudButton Variant="Variant.Text"
                           Color="@(ActiveTab == "documents" ? Color.Primary : Color.Default)"
                           StartIcon="@Icons.Material.Filled.Folder"
                           FullWidth="true"
                           OnClick="@(() => SetActiveTab("documents"))"
                           Style="justify-content: flex-start; padding: 10px 16px; border-radius: 8px;">
                    Dokument
                </MudButton>

            </MudStack>
        </MudPaper>
    </MudItem>

    <!-- Innehåll -->
    <MudItem xs="12" md="9" lg="10">
        <MudPaper Class="pa-4" Elevation="2" Style="border-radius: 12px; min-height: 100vh;">
            @switch (ActiveTab)
            {
                case "feeds":
                    <AdminFeed />
                    break;
                case "houses":
                    <AdminHouseMgmt />
                    break;
         
                    
                case "users":
                    <UsersList />
                    break;
               
                default:
                    <MudText>Välj en flik i menyn.</MudText>
                    break;
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private string ActiveTab { get; set; } = "feeds";

    private void SetActiveTab(string tab)
    {
        ActiveTab = tab;
    }
} *@