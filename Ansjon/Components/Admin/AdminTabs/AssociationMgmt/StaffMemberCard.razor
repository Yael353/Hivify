@using Ansjon.UseCases.Association.DTOs
@using MudBlazor

<MudCard Elevation="0"
         Style="border: 1px solid #e9edf2; border-radius: 10px;">

    <MudCardContent>

        <MudText Typo="Typo.body1"
                 Class="fw-semibold">

            @Member.FullName

        </MudText>

        <MudText Typo="Typo.body2"
                 Color="Color.Secondary"
                 Class="mt-1">

            @Member.Role

        </MudText>

    </MudCardContent>

</MudCard>


@code {

    [Parameter, EditorRequired]
    public StaffMemberDto Member { get; set; } = default!;
}