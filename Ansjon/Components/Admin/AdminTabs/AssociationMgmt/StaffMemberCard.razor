@using Ansjon.UseCases.Association.DTOs
<h3>StaffMemeberCard</h3>
<MudCard>

  <MudCardContent>

    <MudText Typo="Typo.h6">
      @Member.FullName
    </MudText>

    <MudText Color="Color.Secondary">

      @Member.Role

    </MudText>

  </MudCardContent>

</MudCard>

@code {

  [Parameter]
  public StaffMemberDto Member { get; set; } = default!;

}
