@using Ansjon.UseCases.Abstractions.Messaging
@using Ansjon.UseCases.Association.Commands.AddAssociation
@using MudBlazor

@inject ISender Sender
@inject ISnackbar Snackbar
@inject ILogger<AddAssociationButton> Logger

<MudPaper Class="pa-4"
          Elevation="2"
          Style="border-radius: 12px;">

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenForm"
               FullWidth="true">

        Lägg till ny kommitté

    </MudButton>

    @if (_isAdding)
    {
        <MudPaper Class="pa-4 mt-4"
                  Elevation="1"
                  Style="border-radius: 12px; border: 1px solid #e9edf2;">

            <MudText Typo="Typo.body1"
                     Color="Color.Primary"
                     Class="font-weight-bold mb-3">

                Ny kommitté

            </MudText>

            <MudStack Spacing="3">

                <MudTextField Label="Namn"
                              @bind-Value="_name"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Namn är obligatoriskt" />

                <MudStack Row="true"
                          Spacing="2"
                          Justify="Justify.FlexEnd">

                    <MudButton Color="Color.Default"
                               Variant="Variant.Outlined"
                               Disabled="_saving"
                               OnClick="Cancel">

                        Avbryt

                    </MudButton>

                    <MudButton Color="Color.Success"
                               Variant="Variant.Filled"
                               Disabled="_saving"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveAssociationAsync">

                        @(_saving ? "Sparar..." : "Spara")

                    </MudButton>

                </MudStack>

            </MudStack>

        </MudPaper>
    }

</MudPaper>

@code {

    [Parameter]
    public EventCallback OnAssociationAdded { get; set; }

    private bool _isAdding;
    private bool _saving;

    private string _name = string.Empty;

    private void OpenForm()
    {
        _isAdding = true;
    }

    private void Cancel()
    {
        ResetForm();
        _isAdding = false;
    }

    private async Task SaveAssociationAsync()
    {
        if (_saving)
            return;

        if (string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add(
                "Fyll i namnet.",
                Severity.Warning);

            return;
        }

        try
        {
            _saving = true;

            var command = new AddAssociationCommand(
                _name.Trim());

            await Sender.Send(command);

            Snackbar.Add(
                "Kommittén skapades!",
                Severity.Success);

            ResetForm();
            _isAdding = false;

            await OnAssociationAdded.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error creating association");

            Snackbar.Add(
                "Kunde inte skapa kommittén.",
                Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void ResetForm()
    {
        _name = string.Empty;
    }
}