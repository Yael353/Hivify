@using Ansjon.UseCases.Abstractions.Messaging
@using Ansjon.UseCases.Association.DTOs
@using Ansjon.UseCases.Association.Queries.GetAssociation
@using MudBlazor

@inject IQuerySender QuerySender

<MudPaper Class="pa-4">

  <MudText Typo="Typo.h5"
    Color="Color.Primary"
    Class="font-weight-bold mb-3">

    Förening

  </MudText>

  @if (_loading)
  {
    <div class="d-flex justify-content-center py-4">

      <MudProgressCircular Indeterminate="true"
        Color="Color.Primary" />

    </div>
  }
  else if (_association is null)
  {
    <MudAlert Severity="Severity.Error">

      Föreningen kunde inte hittas.

    </MudAlert>
  }
  else
  {
    <MudText Typo="Typo.h6"
      Class="mb-4">

      @_association.Name

    </MudText>

    <AssociationMembers AssociationId="AssociationId" />
  }

</MudPaper>

@code {

  [Parameter, EditorRequired]
  public Guid AssociationId { get; set; }

  private AssociationListDto? _association;

  private bool _loading;


  protected override async Task OnInitializedAsync()
  {
    await LoadAssociationAsync();
  }


  private async Task LoadAssociationAsync()
  {
    _loading = true;

    try
    {
      _association = await QuerySender.Send( new GetAssociationQuery(AssociationId));
    }
    finally
    {
      _loading = false;
    }
  }
}