@using Ansjon.UseCases.Abstractions.Messaging
@using Ansjon.UseCases.Association.DTOs
@using Ansjon.UseCases.Association.Queries.GetAssociation
@using MudBlazor

@inject IQuerySender QuerySender

<MudPaper Class="pa-4">

    <MudText Typo="Typo.h5"
             Color="Color.Primary"
             Class="font-weight-bold mb-3">

        Styrelsemedlemmar

    </MudText>

    <MudText Typo="Typo.body2"
             Color="Color.Tertiary"
             Class="mb-4">

        Hantera styrelsemedlemmarna i denna förening.

    </MudText>

    <MudDivider Class="mb-4" />

    <AddAssociationMember AssociationId="AssociationId"
                          OnMemberAdded="RefreshMembers" />

    <MudDivider Class="my-4" />

    @if (_loading)
    {
        <div class="d-flex justify-content-center py-4">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />

        </div>
    }
    else if (_association is null)
    {
        <MudAlert Severity="Severity.Error">
            Föreningen kunde inte hittas.
        </MudAlert>
    }
    else if (_association.StaffMembers.Count == 0)
    {
        <MudText Color="Color.Secondary">
            Det finns inga styrelsemedlemmar.
        </MudText>
    }
    else
    {
        <StaffMembersList Members="_association.StaffMembers" />
    }

</MudPaper>

@code {

    [Parameter, EditorRequired]
    public Guid AssociationId { get; set; }

    private AssociationListDto? _association;

    private bool _loading;


    protected override async Task OnInitializedAsync()
    {
        await LoadMembersAsync();
    }


    private async Task LoadMembersAsync()
    {
        _loading = true;

        try
        {
            _association =await QuerySender.Send( new GetAssociationQuery(AssociationId));
        }
        finally
        {
            _loading = false;
        }
    }


    private Task RefreshMembers()
    {
        return LoadMembersAsync();
    }
}