@using Ansjon.Core.Aggregates.Complaints
@using Ansjon.UseCases.Abstractions.Messaging
@using Ansjon.UseCases.Complaints.DTOs
@using Ansjon.UseCases.Complaints.Queries.GetComplaint
@using MudBlazor

@inject IQuerySender QuerySender
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
 

    <!-- Innehåll -->
    <MudPaper Class="pa-5" Elevation="1" Style="border-radius: 12px;">
        @if (_complaints == null)
        {
            <div class="text-center py-8">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Class="mt-3" Color="Color.Tertiary">Laddar ärenden...</MudText>
            </div>
        }
        else if (!_complaints.Any())
        {
            <div class="text-center py-8">
                <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Color="Color.Tertiary" />
                <MudText Typo="Typo.h5" Color="Color.Tertiary" Class="mt-3">
                    Inga ärenden har kommit in ännu.
                </MudText>
                <MudText Color="Color.Tertiary" Class="mt-1">
                    När någon skickar in ett ärende visas det här.
                </MudText>
            </div>
        }
        else
        {
            <MudStack Spacing="4">
                @foreach (var complaint in _complaints)
                {
                    <MudCard Elevation="1" Style="border-radius: 12px; border-left: 4px solid #3f51b5; transition: all 0.2s ease;">
                        <MudCardContent Class="pa-3 pa-md-4">
                            <!-- Rad 1: Titel + Status + Åtgärd -->
                            <MudGrid>
                                <MudItem xs="12" sm="7">
                                    <MudText Typo="Typo.h6" Color="Color.Default" Class="font-weight-medium">
                                        @complaint.Title
                                    </MudText>
                                </MudItem>
                                <MudItem xs="12" sm="5" Class="d-flex flex-wrap justify-content-start justify-content-sm-end align-items-center gap-2">
                                    <MudChip T="string"
                                             Color="@(complaint.Status == ComplaintStatus.Ny ? Color.Warning :
                                                     complaint.Status == ComplaintStatus.Granskas ? Color.Info :
                                                     complaint.Status == ComplaintStatus.Pågår ? Color.Info :
                                                     complaint.Status == ComplaintStatus.Löst ? Color.Success : Color.Default)"
                                             Size="Size.Small">
                                        @complaint.Status
                                    </MudChip>
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="@(() => NavigationManager.NavigateTo($"/admin/arandehantering/{complaint.Id}"))"
                                               Style="border-radius: 40px; padding: 4px 16px; text-transform: none; font-weight: 400;">
                                        Hantera
                                    </MudButton>
                                </MudItem>
                            </MudGrid>

                            <MudDivider Class="my-2" Style="opacity: 0.4;" />

                            <!-- Rad 2: Kategori + Skapad datum -->
                            <MudGrid>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                        <MudIcon Icon="@Icons.Material.Filled.Label" Size="Size.Small" />
                                        @complaint.Category
                                    </MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6" Class="d-flex justify-content-start justify-content-sm-end">
                                    <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                                        @complaint.CreatedDate.ToString("dd MMM yyyy, HH:mm")
                                    </MudText>
                                </MudItem>
                            </MudGrid>

                            <!-- Rad 3: Beskrivning (kort) -->
                            <MudDivider Class="my-2" Style="opacity: 0.3;" />
                            <MudText Typo="Typo.body2" Color="Color.Default" Style="color: #555; white-space: pre-wrap; line-height: 1.6;">
                                @(complaint.Description.Length > 120 ? complaint.Description.Substring(0, 120) + "..." : complaint.Description)
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                }
            </MudStack>
        }
    </MudPaper>
</MudContainer>

<style>
    .mud-container {
        background: #ffffff;
        min-height: 100vh;
    }

    .mud-paper {
        transition: all 0.2s ease;
    }

    .mud-paper:hover {
        box-shadow: 0 4px 16px rgba(63, 81, 181, 0.06) !important;
    }

    .mud-card {
        transition: all 0.2s ease;
    }

    .mud-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(63, 81, 181, 0.08) !important;
        border-color: #c5cae9;
    }

    .gap-2 {
        gap: 8px;
    }

    /* Responsivt – mobil */
    @@media (max-width: 768px) {
        .mud-container {
            padding-left: 12px !important;
            padding-right: 12px !important;
        }

        .mud-paper {
            padding: 16px !important;
        }

        .mud-card-content {
            padding: 12px !important;
        }

        .mud-card {
            border-left-width: 3px !important;
        }

        .mud-text-h6 {
            font-size: 1rem !important;
        }
    }
</style>

@code {
    private IReadOnlyList<ComplaintListItemDto>? _complaints;

    protected override async Task OnInitializedAsync()
    {
        var query = new GetAllComplaintsQuery();
        _complaints = await QuerySender.Send(query);
    }
}