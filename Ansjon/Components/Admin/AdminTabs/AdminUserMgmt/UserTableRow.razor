@using Ansjon.UseCases.Admin.DTOs
@using Ansjon.UseCases.Admin.DTOs.UserMngDtos

<MudTd DataLabel="User">

  <MudStack Row="true"
    AlignItems="AlignItems.Center"
    Spacing="2">

    <MudAvatar Color="Color.Primary"
      Size="Size.Medium">

      @GetInitials(User.UserName, User.Email)

    </MudAvatar>

    <MudStack Spacing="0">

      <MudText Typo="Typo.body1">
        @(User.UserName ?? "No username")
      </MudText>

      <MudText Typo="Typo.caption"
        Color="Color.Secondary">

        @(User.Email ?? "No email")

      </MudText>

    </MudStack>

  </MudStack>

</MudTd>

<MudTd DataLabel="Email">

  @(User.Email ?? "—")

</MudTd>

<MudTd DataLabel="Email Confirmed">

  @if (User.EmailConfirmed)
  {
    <MudChip T="string"
      Size="Size.Small"
      Color="Color.Success"
      Variant="Variant.Outlined"
      Icon="@Icons.Material.Filled.Check">

      Confirmed

    </MudChip>
  }
  else
  {
    <MudChip T="string"
      Size="Size.Small"
      Color="Color.Warning"
      Variant="Variant.Outlined"
      Icon="@Icons.Material.Filled.Warning">

      Not confirmed

    </MudChip>
  }

</MudTd>

<MudTd DataLabel="User ID">

  <MudText Typo="Typo.caption">
    @User.UserId
  </MudText>

</MudTd>

<MudTd DataLabel="Actions" Align="Align.Right">

  <MudButton Variant="Variant.Outlined"
    Size="Size.Small"
    StartIcon="@Icons.Material.Filled.ManageAccounts"
    Href="@($"/admin/usermanagement/{User.UserId}")">

    Manage

  </MudButton>

</MudTd>

@code {

  [Parameter]
  public UserListItem User { get; set; } = default!;

  private static string GetInitials(
      string? userName,
      string? email)
  {
    var value = userName;

    if (string.IsNullOrWhiteSpace(value))
      value = email;

    if (string.IsNullOrWhiteSpace(value))
      return "?";

    var parts = value.Split(
        ' ',
        StringSplitOptions.RemoveEmptyEntries);

    if (parts.Length >= 2)
    {
      return string.Concat(
              parts[0][0],
              parts[1][0])
          .ToUpperInvariant();
    }

    return value[..1].ToUpperInvariant();
  }

}