@using Ansjon.UseCases.Abstractions.Messaging
@using Ansjon.UseCases.Documents.Commands
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor


@inject ISender Sender
@inject ISnackbar Snackbar
@inject ILogger<UploadDocument> Logger

<MudPaper Class="pa-4"
  Elevation="2"
  Style="border-radius: 12px;">

  <MudText Typo="Typo.h6"
    Color="Color.Primary"
    Class="mb-3">

    Ladda upp dokument

  </MudText>

  <InputFile OnChange="OnFileSelected"
    accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg" />

  @if (_selectedFile is not null)
  {
    <MudPaper Class="pa-3 mt-3"
      Outlined="true">

      <MudStack Row="true"
        AlignItems="AlignItems.Center"
        Justify="Justify.SpaceBetween">

        <div>

          <MudText Typo="Typo.body1">
            @_selectedFile.Name
          </MudText>

          <MudText Typo="Typo.caption"
            Color="Color.Secondary">

            @FormatFileSize(_selectedFile.Size)

          </MudText>

        </div>

        <MudButton Variant="Variant.Filled"
          Color="Color.Primary"
          Disabled="_uploading"
          OnClick="UploadAsync">

          @if (_uploading)
          {
            <MudProgressCircular Indeterminate="true"
              Size="Size.Small"
              Class="me-2" />

            <span>Laddar upp...</span>
          }
          else
          {
            <span>Ladda upp</span>
          }

        </MudButton>

      </MudStack>

    </MudPaper>
  }

  @if (_errorMessage is not null)
  {
    <MudAlert Severity="Severity.Error"
      Class="mt-3">

      @_errorMessage

    </MudAlert>
  }

</MudPaper>

@code {

  [Parameter]
  public EventCallback OnDocumentUploaded { get; set; }

  private IBrowserFile? _selectedFile;

  private bool _uploading;

  private string? _errorMessage;

  private const long MaxFileSize = 20 * 1024 * 1024;

  private void OnFileSelected(InputFileChangeEventArgs args)
  {
    _errorMessage = null;

    var file = args.File;

    if (file.Size > MaxFileSize)
    {
      _selectedFile = null;

      _errorMessage =
          "Filen får inte vara större än 20 MB.";

      return;
    }

    _selectedFile = file;
  }

  private async Task UploadAsync()
  {
    if (_selectedFile is null || _uploading)
      return;

    _uploading = true;
    _errorMessage = null;

    try
    {
      await using var stream =
          _selectedFile.OpenReadStream(MaxFileSize);

      var command = new UploadDocumentCommand(
          _selectedFile.Name,
          _selectedFile.ContentType,
          stream);

      await Sender.Send(command);

      Snackbar.Add(
          "Dokumentet laddades upp.",
          Severity.Success);

      _selectedFile = null;

      await OnDocumentUploaded.InvokeAsync();
    }
    catch (Exception ex)
    {
      Logger.LogError(
          ex,
          "Failed to upload document");

      _errorMessage =
          "Kunde inte ladda upp dokumentet.";
    }
    finally
    {
      _uploading = false;
    }
  }

  private static string FormatFileSize(long bytes)
  {
    if (bytes < 1024)
      return $"{bytes} B";

    if (bytes < 1024 * 1024)
      return $"{bytes / 1024.0:F1} KB";

    return $"{bytes / 1024.0 / 1024.0:F1} MB";
  }
}