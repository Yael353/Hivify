@using Ansjon.Core.Aggregates.Associations
@using Ansjon.Core.Aggregates.Associations.Members
@using Ansjon.UseCases.Abstractions.Context
@using Ansjon.UseCases.Abstractions.Messaging
@using Ansjon.UseCases.Association.Commands

@inject ICurrentAssociationProvider AssociationProvider
@inject ISender Sender



<MudDialog>
  <DialogContent>

    <EditForm Model="_model" OnValidSubmit="Save">

      <MudTextField Label="Namn"
        @bind-Value="_model.FullName" />

      <MudSelect T="MemberRole"
        Label="Roll"
        @bind-Value="_model.Role">

        @foreach (var role in Enum.GetValues<MemberRole>())
        {
          <MudSelectItem Value="@role">@role</MudSelectItem>
        }

      </MudSelect>

    </EditForm>

  </DialogContent>

  <DialogActions>

    <MudButton Variant="Variant.Text"
      OnClick="Cancel">
      Avbryt
    </MudButton>

    <MudButton Color="Color.Primary"
      OnClick="Save">
      Spara
    </MudButton>

  </DialogActions>
</MudDialog>

@code {

  [Parameter]
  public AssociationID AssociationId { get; set; } = default!;


  [CascadingParameter]
  private IMudDialogInstance MudDialog { get; set; } = default!;


  private readonly AddStaffMemberModel _model = new();


  private async Task Save()
  {
    var associationId =
        await AssociationProvider.GetAssociationIdAsync();


    var command = new AddStaffMemberCommand(
        associationId,
        _model.FullName,
        _model.Role);


    await Sender.Send(command);


    MudDialog.Close(DialogResult.Ok(true));
  }


  private void Cancel()
  {
    MudDialog.Cancel();
  }


  private sealed class AddStaffMemberModel
  {
    public string FullName { get; set; } = string.Empty;

    public MemberRole Role { get; set; }
  }
}