@attribute [Authorize(Roles = "Admin")]

@using Ansjon.UseCases.Feeds.DTOs
@using Microsoft.AspNetCore.Authorization
@using MudBlazor

<MudCard Class="feed-card" Elevation="1">

  @if (_editing)
  {
    <EditFeedForm Feed="Feed"
      OnSaved="HandleSaved"
      OnCancelled="HandleCancelled" />
  }
  else
  {
    <MudCardHeader>

      <CardHeaderContent>
        <MudText Typo="Typo.h6"
          Color="Color.Primary">

          @Feed.Title

        </MudText>
      </CardHeaderContent>

      <CardHeaderActions>

        <MudIconButton Icon="@Icons.Material.Filled.Edit"
          Color="Color.Primary"
          OnClick="StartEdit" />

        <FeedActions FeedId="Feed.Id"
          OnDeleted="HandleDeleted" />

      </CardHeaderActions>

    </MudCardHeader>

    <MudDivider />

    <MudCardContent Class="pa-5">

      <MudText Typo="Typo.body2"
        Color="Color.Dark"
        Style="white-space:pre-wrap;">

        @Feed.Content

      </MudText>

      <MudText Typo="Typo.caption"
        Color="Color.Tertiary"
        Class="mt-4">

        @Feed.CreatedDate.ToString("dd MMM yyyy, HH:mm")

      </MudText>

    </MudCardContent>
  }

</MudCard>

<style>
  .feed-card {
    border-radius: 12px;
    transition: box-shadow 0.2s ease;
  }

    .feed-card:hover {
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08) !important;
    }
</style>

@code {

  [Parameter]
  public FeedListItemDto Feed { get; set; } = default!;

  [Parameter]
  public EventCallback OnChanged { get; set; }

  private bool _editing;

  private void StartEdit()
  {
    _editing = true;
  }

  private void HandleCancelled()
  {
    _editing = false;
  }

  private async Task HandleSaved()
  {
    _editing = false;

    await OnChanged.InvokeAsync();
  }

  private async Task HandleDeleted()
  {
    await OnChanged.InvokeAsync();
  }
}