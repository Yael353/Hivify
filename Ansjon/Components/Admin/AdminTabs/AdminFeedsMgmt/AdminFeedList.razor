@using Ansjon.UseCases.Abstractions.Messaging
@using Ansjon.UseCases.Feeds.DTOs
@using Ansjon.UseCases.Feeds.Queries.GetFeeds
@using MudBlazor

@inject IQuerySender QuerySender

@if (_loading)
{
  <div class="text-center py-6">
    <MudProgressCircular Indeterminate="true"
      Color="Color.Primary" />

    <MudText Class="mt-3"
      Color="Color.Tertiary">
      Laddar feeds...
    </MudText>
  </div>
}
else if (!_feeds.Any())
{
  <div class="text-center py-8">

    <MudIcon Icon="@Icons.Material.Filled.Article"
      Size="Size.Large"
      Color="Color.Tertiary" />

    <MudText Typo="Typo.h5"
      Class="mt-2">
      Inga feeds ännu
    </MudText>

    <MudText Color="Color.Tertiary">
      Skapa din första feed nedan.
    </MudText>

  </div>
}
else
{
  <MudStack Spacing="4">

    @foreach (var feed in _feeds)
    {
      <AdminFeedCard Feed="feed"
        OnChanged="Refresh" />
    }

  </MudStack>
}

@code {

  private IReadOnlyList<FeedListItemDto> _feeds = [];

  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    await Refresh();
  }

  public async Task Refresh()
  {
    _loading = true;

    await InvokeAsync(StateHasChanged);

    try
    {
      var query = new GetFeedsQuery();

      _feeds = await QuerySender.Send(query);
    }
    finally
    {
      _loading = false;

      await InvokeAsync(StateHasChanged);
    }
  }
}