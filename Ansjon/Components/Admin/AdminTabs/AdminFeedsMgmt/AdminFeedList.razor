@using Ansjon.Core.Aggregates.Feeds
@using Ansjon.UseCases.Feeds.Queries
@using MudBlazor

@inject ViewFeeds ViewFeeds

@if (_loading)
{
    <div class="text-center py-6">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        <MudText Class="mt-3" Color="Color.Tertiary">Laddar feeds...</MudText>
    </div>
}
else if (!_feeds.Any())
{
    <div class="text-center py-8">
        <MudIcon Icon="@Icons.Material.Filled.Article" Size="Size.Large" Color="Color.Tertiary" />
        <MudText Typo="Typo.h5" Class="mt-2">Inga feeds ännu</MudText>
        <MudText Color="Color.Tertiary">Skapa din första feed nedan.</MudText>
    </div>
}
else
{
    <MudStack Spacing="4">
        @foreach (var feed in _feeds.OrderByDescending(x => x.CreatedDate))
        {
            <AdminFeedCard Feed="feed" OnChanged="Refresh" />
        }
    </MudStack>
}

@code {
    private List<Feed> _feeds = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
    }

    public async Task Refresh()
    {
        _loading = true;
        StateHasChanged();

        _feeds = (await ViewFeeds.GetAllFeedsAsync())
            .OrderByDescending(x => x.CreatedDate)
            .ToList();

        _loading = false;
        StateHasChanged();
    }
}