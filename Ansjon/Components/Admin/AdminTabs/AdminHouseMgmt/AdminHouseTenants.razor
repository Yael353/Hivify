@using Ansjon.UseCases.Abstractions.Messaging
@using Ansjon.UseCases.Houses.DTOs
@using Ansjon.UseCases.Houses.Queries.GetHouseTenants
@using MudBlazor
@using Ansjon.UseCases.Houses.Commands.RemoveTenant

@inject IQuerySender QuerySender
@inject ISender Sender
@inject ISnackbar Snackbar
@inject ILogger<AdminHouseTenants> Logger

@inject IQuerySender QuerySender

<MudStack Spacing="3">

  <MudStack Row="true"
    AlignItems="AlignItems.Center"
    Justify="Justify.SpaceBetween">

    <MudText Typo="Typo.h6"
      Color="Color.Primary"
      Class="font-weight-bold">
      Boende
    </MudText>

    <MudText Typo="Typo.caption"
      Color="Color.Tertiary">
      @_tenants.Count boende
    </MudText>

  </MudStack>

  @if (_loading)
  {
    <div class="d-flex justify-center pa-4">

      <MudProgressCircular Indeterminate="true"
        Color="Color.Primary" />

    </div>
  }
  else if (_tenants.Count == 0)
  {
    <MudText Color="Color.Tertiary"
      Class="text-center pa-4">

      Inga boende registrerade i detta hus ännu.

    </MudText>
  }
  else
  {
    <MudStack Spacing="2">

      @foreach (var tenant in _tenants)
      {
        <MudPaper Class="pa-3"
          Elevation="0"
          Style="border-radius: 8px; background: #f8faff;">

          <MudStack Row="true"
            AlignItems="AlignItems.Center"
            Justify="Justify.SpaceBetween">

            <div>
              <MudText Typo="Typo.body1">
                @tenant.FullName
              </MudText>

              <MudText Typo="Typo.caption"
                Color="Color.Tertiary">
                @tenant.Email
              </MudText>
            </div>

            <MudIconButton Icon="@Icons.Material.Filled.Delete"
              Color="Color.Error"
              Size="Size.Small"
              Disabled="_deletingTenantId == tenant.Id"
              OnClick="@(() => DeleteTenantAsync(tenant.Id))" />

          </MudStack>

        </MudPaper>
      
      }

    </MudStack>
  }

  <AddTenantButton HouseId="HouseId"
    OnTenantAdded="Refresh" />

</MudStack>

@code {

  [Parameter]
  public Guid HouseId { get; set; }

  private List<TenantListItemDto> _tenants = [];

  private bool _loading;

  private Guid? _deletingTenantId;

  protected override async Task OnParametersSetAsync()
  {
    await Refresh();
  }

  public async Task Refresh()
  {
    if (HouseId == Guid.Empty)
      return;

    _loading = true;

    try
    {
      var tenants = await QuerySender.Send(
          new GetHouseTenantsQuery(HouseId));

      _tenants = tenants.ToList();
    }
    finally
    {
      _loading = false;
    }
  }
  private async Task DeleteTenantAsync(Guid tenantId)
  {
    if (_deletingTenantId.HasValue)
      return;

    try
    {
      _deletingTenantId = tenantId;

      var deleted = await Sender.Send(
          new RemoveHouseTenantCommand(
              HouseId,
              tenantId));

      if (!deleted)
      {
        Snackbar.Add(
            "Boende eller hus kunde inte hittas.",
            Severity.Error);

        return;
      }

      Snackbar.Add(
          "Boende togs bort.",
          Severity.Success);

      await Refresh();
    }
    catch (Exception ex)
    {
      Logger.LogError(
          ex,
          "Error removing tenant {TenantId} from house {HouseId}",
          tenantId,
          HouseId);

      Snackbar.Add(
          "Kunde inte ta bort boende.",
          Severity.Error);
    }
    finally
    {
      _deletingTenantId = null;
    }
  }
}