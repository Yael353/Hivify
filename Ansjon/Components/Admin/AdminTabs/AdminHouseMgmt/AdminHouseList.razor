@using Ansjon.UseCases.Abstractions.Messaging
@using Ansjon.UseCases.Houses.DTOs
@using Ansjon.UseCases.Houses.Queries.GetHouses
@using MudBlazor

@inject IQuerySender QuerySender
@inject NavigationManager NavigationManager


@if (_loading)
{
  <div class="text-center py-6">

    <MudProgressCircular Indeterminate="true"
      Color="Color.Primary" />

    <MudText Class="mt-3"
      Color="Color.Tertiary">
      Laddar hus...
    </MudText>

  </div>
}
else if (_houses.Count == 0)
{
  <div class="text-center py-6">

    <MudIcon Icon="@Icons.Material.Filled.House"
      Size="Size.Large"
      Color="Color.Tertiary" />

    <MudText Typo="Typo.h6"
      Class="mt-2">
      Inga hus ännu
    </MudText>

    <MudText Color="Color.Tertiary">
      Lägg till ditt första hus ovan.
    </MudText>

  </div>
}
else
{
  <MudTable Items="_houses"
    Hover="true"
    Striped="true"
    Bordered="true"
    Elevation="1"
    Class="mt-2"
    Style="border-radius: 12px; overflow: hidden;">

    <HeaderContent>

      <MudTh>
        Adress
      </MudTh>

      <MudTh>
        Husnummer
      </MudTh>

      <MudTh>
        Postnummer
      </MudTh>

      <MudTh Class="text-right">
        Åtgärd
      </MudTh>

    </HeaderContent>


    <RowTemplate>

      <MudTd>
        @context.Address
      </MudTd>

      <MudTd>
        @context.HouseNumber
      </MudTd>

      <MudTd>
        @context.PostalCode
      </MudTd>

      <MudTd Class="text-right">

        <MudButton Variant="Variant.Filled"
          Color="Color.Primary"
          Size="Size.Small"
          OnClick="@(() => OpenHouse(context.Id))">

          Se detaljer

        </MudButton>

      </MudTd>

    </RowTemplate>

  </MudTable>
}


@code {

  private IReadOnlyList<HouseListItemDto> _houses = [];

  private bool _loading = true;


  protected override async Task OnInitializedAsync()
  {
    await Refresh();
  }


  public async Task Refresh()
  {
    _loading = true;

    await InvokeAsync(StateHasChanged);

    try
    {
      _houses = await QuerySender.Send(
          new GetHousesQuery());
    }
    finally
    {
      _loading = false;

      await InvokeAsync(StateHasChanged);
    }
  }


  private void OpenHouse(Guid houseId)
  {
    NavigationManager.NavigateTo(
        $"/admin/hus/{houseId}");
  }
}