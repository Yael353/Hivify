@using Ansjon.UseCases.Houses.DTOs
@using MudBlazor

<MudTable Items="@_houses" 
          Hover="true" 
          Striped="true" 
          Bordered="true" 
          Elevation="1" 
          Class="mt-2"
          Style="border-radius: 12px; overflow: hidden;">

    <HeaderContent>
        <MudTh>Adress</MudTh>
        <MudTh>Husnummer</MudTh>
       
        <MudTh Class="text-right">Åtgärd</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd>@context.Address</MudTd>
        <MudTd>@context.HouseNumber</MudTd>
       <MudTd Class="text-center">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Small"
                       OnClick="@(() => OnHouseSelected.InvokeAsync(context))">
                Se detaljer
            </MudButton>
        </MudTd>
    </RowTemplate>

    @* <NoDataContent>
        <MudText Color="Color.Tertiary" Class="text-center pa-6">
            Inga hus hittades.
        </MudText>
    </NoDataContent> *@
</MudTable>

@code {
    [Parameter]
    public EventCallback<HouseDto> OnHouseSelected { get; set; }

    private List<HouseDto> _houses = new()
    {
        new HouseDto(Guid.NewGuid(), "Storgatan 1", "10", "211 20", DateTime.Now),
        new HouseDto(Guid.NewGuid(), "Parkvägen 5", "25", "211 30", DateTime.Now),
        new HouseDto(Guid.NewGuid(), "Sjöstrand 3", "8", "211 40", DateTime.Now),
        new HouseDto(Guid.NewGuid(), "Bäckgatan 7", "12", "211 50", DateTime.Now),
        new HouseDto(Guid.NewGuid(), "Lundavägen 12", "5", "222 30", DateTime.Now),
        new HouseDto(Guid.NewGuid(), "Malmövägen 3", "2", "211 60", DateTime.Now)
    };
}