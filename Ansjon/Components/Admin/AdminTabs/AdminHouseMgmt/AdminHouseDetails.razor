@using Ansjon.UseCases.Houses.DTOs
@using MudBlazor

<MudPaper Class="pa-4"
          Elevation="2"
          Style="border-radius: 12px;">

    <MudText Typo="Typo.h6"
             Color="Color.Primary"
             Class="font-weight-bold mb-4">
        Husdetaljer
    </MudText>

    <MudGrid>

        <MudItem xs="12" md="4">

            <MudText Typo="Typo.caption"
                     Color="Color.Tertiary">
                Adress
            </MudText>

            <MudText Typo="Typo.body1">
                @House.Address
            </MudText>

        </MudItem>

        <MudItem xs="12" md="4">

            <MudText Typo="Typo.caption"
                     Color="Color.Tertiary">
                Husnummer
            </MudText>

            <MudText Typo="Typo.body1">
                @House.HouseNumber
            </MudText>

        </MudItem>

        <MudItem xs="12" md="4">

            <MudText Typo="Typo.caption"
                     Color="Color.Tertiary">
                Postnummer
            </MudText>

            <MudText Typo="Typo.body1">
                @House.PostalCode
            </MudText>

        </MudItem>

    </MudGrid>

    <MudDivider Class="my-4" />

    <AdminEditHouse  House="House" OnHouseUpdated="OnHouseUpdated" />

</MudPaper>

@code {

    [Parameter, EditorRequired]
    public HouseListItemDto House { get; set; } = default!;

    [Parameter]
    public EventCallback OnHouseUpdated { get; set; }
}