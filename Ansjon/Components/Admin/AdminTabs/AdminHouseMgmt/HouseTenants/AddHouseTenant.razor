@using Ansjon.UseCases.Abstractions.Messaging
@using Ansjon.UseCases.AdminUserMgmt.DTOs
@using Ansjon.UseCases.Houses.Commands.AddTenant
@using Ansjon.Components.Admin.AdminTabs.AdminUserMgmt
@using MudBlazor

@inject ISender Sender
@inject IDialogService DialogService
@inject ILogger<AddHouseTenant> Logger

<div class="mb-4">

  <h2 class="h5 mb-2">
    Lägg till boende
  </h2>

  <p class="text-muted">
    Välj en registrerad användare och lägg till
    användaren som boende i detta hus.
  </p>

  @if (_errorMessage is not null)
  {
    <div class="alert alert-danger">
      @_errorMessage
    </div>
  }

  @if (_selectedUser is not null)
  {
    <div class="border rounded p-3 mb-3">

      <div class="d-flex align-items-center gap-3">

        <div class="rounded-circle bg-primary text-white
          d-flex align-items-center justify-content-center"
          style="width: 40px; height: 40px;">

          @GetInitials(_selectedUser)

        </div>

        <div>

          <div class="fw-semibold">
            @GetUserDisplayName(_selectedUser)
          </div>

          @if (!string.IsNullOrWhiteSpace(_selectedUser.Email))
          {
            <div class="text-muted small">
              @_selectedUser.Email
            </div>
          }

        </div>

      </div>

    </div>
  }

  <div class="d-flex justify-content-end gap-2 mt-3">

    <MudButton Variant="Variant.Outlined"
      Color="Color.Primary"
      StartIcon="@Icons.Material.Filled.PersonSearch"
      OnClick="OpenUserPickerAsync">

      Välj användare

    </MudButton>

    <MudButton Variant="Variant.Filled"
      Color="Color.Success"
      StartIcon="@Icons.Material.Filled.Add"
      Disabled="@(_selectedUser is null || _saving)"
      OnClick="AddTenantAsync">

      @if (_saving)
      {
        <MudProgressCircular Indeterminate="true"
          Size="Size.Small"
          Class="me-2" />

        <span>
          Lägger till...
        </span>
      }
      else
      {
        <span>
          Lägg till som boende
        </span>
      }

    </MudButton>

  </div>

</div>

@code {

  [Parameter, EditorRequired]
  public Guid HouseId { get; set; }

  [Parameter]
  public EventCallback OnTenantAdded { get; set; }

  private UserListItem? _selectedUser;

  private bool _saving;

  private string? _errorMessage;


  private async Task OpenUserPickerAsync()
  {
    _errorMessage = null;

    var options = new DialogOptions
    {
      CloseOnEscapeKey = true,
      MaxWidth = MaxWidth.Small,
      FullWidth = true
    };

    var dialog =
        await DialogService.ShowAsync<UserPickerDialog>(
            "Välj användare",
            options);

    var result =
        await dialog.Result;

    if (result.Canceled)
      return;

    var selectedUser =
        result.Data as UserListItem;

    if (selectedUser is null)
      return;

    _selectedUser = selectedUser;
  }


  private async Task AddTenantAsync()
  {
    if (_saving || _selectedUser is null)
      return;

    var userId = _selectedUser.Id;
    var email = _selectedUser.Email ?? string.Empty;

    _saving = true;
    _errorMessage = null;

    try
    {
      await Sender.Send(
          new AddHouseTenantCommand(
              HouseId,
              userId,
              email));

      _selectedUser = null;

      await OnTenantAdded.InvokeAsync();
    }
    catch (Exception ex)
    {
      Logger.LogError(
          ex,
          "Failed to add user {UserId} to house {HouseId}",
          userId,
          HouseId);

      _errorMessage =
          "Kunde inte lägga till användaren som boende.";
    }
    finally
    {
      _saving = false;
    }
  }


  private static string GetUserDisplayName(
      UserListItem user)
  {
    return user.FullName
        ?? user.UserName
        ?? user.Email
        ?? user.Id.ToString();
  }


  private static string GetInitials(
      UserListItem user)
  {
    var value =
        user.FullName
        ?? user.UserName
        ?? user.Email;

    if (string.IsNullOrWhiteSpace(value))
      return "?";

    var parts =
        value.Split(
            ' ',
            StringSplitOptions.RemoveEmptyEntries);

    if (parts.Length >= 2)
    {
      return string.Concat(
              parts[0][0],
              parts[^1][0])
          .ToUpperInvariant();
    }

    return value[..1].ToUpperInvariant();
  }
}