
@using Ansjon.UseCases.Abstractions.Presistence
@using Ansjon.UseCases.AdminUserMgmt.DTOs
@using MudBlazor

@inject IUserManagementService UserManagementService
@inject ILogger<UserPicker> Logger

<MudAutocomplete T="UserListItem"
  Label="@Label"
  Placeholder="Sök efter användare..."
  Variant="Variant.Outlined"
  Dense="true"
  Clearable="true"
  ResetValueOnEmptyText="true"
  ToStringFunc="GetDisplayName"
  SearchFunc="SearchUsersAsync"
  Value="SelectedUser"
  ValueChanged="OnUserChanged"
  Disabled="_loading">

  <ItemTemplate Context="user">

    <MudStack Row="true"
      AlignItems="AlignItems.Center"
      Spacing="2">

      <MudAvatar Color="Color.Primary"
        Size="Size.Small">

        @GetInitials(user)

      </MudAvatar>

      <MudStack Spacing="0">

        <MudText Typo="Typo.body2">
          @(user.UserName ?? "Okänd användare")
        </MudText>

        <MudText Typo="Typo.caption"
          Color="Color.Secondary">

          @(user.Email ?? "Ingen e-post")

        </MudText>

      </MudStack>

    </MudStack>

  </ItemTemplate>

  <NoItemsTemplate>

    <MudText Class="pa-3"
      Typo="Typo.body2"
      Color="Color.Tertiary">

      Inga användare hittades.

    </MudText>

  </NoItemsTemplate>

</MudAutocomplete>

@if (_loading)
{
  <MudStack Row="true"
    AlignItems="AlignItems.Center"
    Spacing="2">

    <MudProgressCircular Indeterminate="true"
      Size="Size.Small"
      Color="Color.Primary" />

    <MudText Typo="Typo.caption"
      Color="Color.Tertiary">

      Laddar användare...

    </MudText>

  </MudStack>
}

@if (_errorMessage is not null)
{
  <MudAlert Severity="Severity.Error"
    Variant="Variant.Outlined">

    @_errorMessage

  </MudAlert>
}

@code {

  [Parameter]
  public string Label { get; set; } = "Sök användare";

  [Parameter]
  public UserListItem? SelectedUser { get; set; }

  [Parameter]
  public EventCallback<UserListItem?> SelectedUserChanged { get; set; }

  private IReadOnlyList<UserListItem> _users = [];

  private bool _loading;
  private bool _usersLoaded;

  private string? _errorMessage;

  private async Task<IEnumerable<UserListItem>> SearchUsersAsync(
      string? searchText,
      CancellationToken cancellationToken)
  {
    if (!_usersLoaded)
    {
      await LoadUsersAsync(cancellationToken);
    }

    if (string.IsNullOrWhiteSpace(searchText))
      return _users;

    return _users
        .Where(user =>
            Contains(user.UserName, searchText) ||
            Contains(user.Email, searchText) ||
            user.Id.ToString().Contains(
                searchText,
                StringComparison.OrdinalIgnoreCase))
        .ToList();
  }

  private async Task LoadUsersAsync(
      CancellationToken cancellationToken)
  {
    if (_usersLoaded || _loading)
      return;

    _loading = true;
    _errorMessage = null;

    try
    {
      _users =
          await UserManagementService.GetUsersAsync(
              cancellationToken);

      _usersLoaded = true;
    }
    catch (OperationCanceledException)
    {
      throw;
    }
    catch (Exception ex)
    {
      Logger.LogError(
          ex,
          "Failed to load Identity users");

      _errorMessage =
          $"Kunde inte ladda användare: {ex.Message}";
    }
    finally
    {
      _loading = false;
    }
  }

  private async Task OnUserChanged(
      UserListItem? user)
  {
    SelectedUser = user;

    await SelectedUserChanged.InvokeAsync(user);
  }

  private static bool Contains(
      string? value,
      string searchText)
  {
    return value?.Contains(
        searchText,
        StringComparison.OrdinalIgnoreCase) == true;
  }

  private static string GetDisplayName(
      UserListItem? user)
  {
    if (user is null)
      return string.Empty;

    return user.UserName
        ?? user.Email
        ?? user.Id.ToString();
  }

  private static string GetInitials(
      UserListItem user)
  {
    var value =
        user.UserName ??
        user.Email;

    if (string.IsNullOrWhiteSpace(value))
      return "?";

    return value[..1].ToUpperInvariant();
  }
}

