@using Ansjon.UseCases.Abstractions.Messaging
@using Ansjon.UseCases.AdminUserMgmt.DTOs
@using Ansjon.UseCases.Houses.Commands.AddTenant
@using Ansjon.UseCases.AdminUserMgmt.Queries.GetUsers
@using MudBlazor

@inject ISender Sender
@inject IQuerySender QuerySender
@inject ISnackbar Snackbar
@inject ILogger<AddTenantButton> Logger

<MudPaper Class="pa-4"
  Elevation="1"
  Style="border-radius: 12px;">

  <MudButton Variant="Variant.Filled"
    Color="Color.Primary"
    StartIcon="@Icons.Material.Filled.PersonAdd"
    FullWidth="true"
    OnClick="OpenForm">

    Lägg till boende

  </MudButton>

  @if (_isAdding)
  {
    <MudPaper Class="pa-4 mt-4"
      Elevation="0"
      Style="border-radius: 12px; border: 1px solid #e9edf2;">

      <MudText Typo="Typo.h6"
        Color="Color.Primary"
        Class="mb-4">

        Lägg till boende

      </MudText>

      <MudStack Spacing="3">

        <MudAutocomplete T="UserListItem"
          Label="Sök användare"
          Variant="Variant.Outlined"
          Value="_selectedUser"
          ValueChanged="OnUserSelected"
          SearchFunc="SearchUsers"
          ToStringFunc="GetUserDisplayName"
          Clearable="true"
          CoerceText="true"
          ResetValueOnEmptyText="true" />

        @if (_selectedUser is not null)
        {
          <MudPaper Class="pa-3"
            Elevation="0"
            Style="background: #f8faff; border-radius: 8px;">

            <MudText Typo="Typo.body1">
              @_selectedUser.UserName
            </MudText>

            <MudText Typo="Typo.caption"
              Color="Color.Tertiary">

              @_selectedUser.Email

            </MudText>

            @if (!string.IsNullOrWhiteSpace(
                _selectedUser.PhoneNumber))
            {
              <MudText Typo="Typo.caption"
                Color="Color.Tertiary">

                @_selectedUser.PhoneNumber

              </MudText>
            }

          </MudPaper>
        }

        <MudStack Row="true"
          Spacing="2"
          Justify="Justify.FlexEnd">

          <MudButton Variant="Variant.Outlined"
            Disabled="_saving"
            OnClick="Cancel">

            Avbryt

          </MudButton>

          <MudButton Variant="Variant.Filled"
            Color="Color.Success"
            Disabled="_saving || _selectedUser is null"
            StartIcon="@Icons.Material.Filled.Save"
            OnClick="SaveTenantAsync">

            @(_saving ? "Sparar..." : "Lägg till")

          </MudButton>

        </MudStack>

      </MudStack>

    </MudPaper>
  }

</MudPaper>

@code {

  [Parameter]
  public Guid HouseId { get; set; }

  [Parameter]
  public EventCallback OnTenantAdded { get; set; }

  private bool _isAdding;
  private bool _saving;

  private UserListItem? _selectedUser;

  private IReadOnlyList<UserListItem> _users = [];

  private void OpenForm()
  {
    _isAdding = true;
  }

  private void Cancel()
  {
    _selectedUser = null;
    _isAdding = false;
  }

  private async Task<IEnumerable<UserListItem>> SearchUsers(
      string value,
      CancellationToken cancellationToken)
  {
    if (_users.Count == 0)
    {
      _users = await QuerySender.Send(
          new GetUsersQuery(),
          cancellationToken);
    }

    if (string.IsNullOrWhiteSpace(value))
      return _users;

    return _users.Where(user =>
        (user.UserName?.Contains(
            value,
            StringComparison.OrdinalIgnoreCase) ?? false)
        ||
        (user.Email?.Contains(
            value,
            StringComparison.OrdinalIgnoreCase) ?? false));
  }

  private void OnUserSelected(UserListItem? user)
  {
    _selectedUser = user;
  }

  private static string GetUserDisplayName(
      UserListItem? user)
  {
    if (user is null)
      return string.Empty;

    if (!string.IsNullOrWhiteSpace(user.UserName))
      return user.UserName;

    if (!string.IsNullOrWhiteSpace(user.Email))
      return user.Email;

    return user.Id.ToString();
  }

  private async Task SaveTenantAsync()
  {
    if (_saving)
      return;

    if (_selectedUser is null)
    {
      Snackbar.Add(
          "Välj en användare.",
          Severity.Warning);

      return;
    }

    try
    {
      _saving = true;

      var command = new AddHouseTenantCommand(
          HouseId,
          _selectedUser.Id);

      await Sender.Send(command);

      Snackbar.Add(
          "Användaren lades till som boende.",
          Severity.Success);

      _selectedUser = null;
      _isAdding = false;

      await OnTenantAdded.InvokeAsync();
    }
    catch (Exception ex)
    {
      Logger.LogError(
          ex,
          "Error adding user {UserId} as tenant to house {HouseId}",
          _selectedUser.Id,
          HouseId);

      Snackbar.Add(
          "Kunde inte lägga till boende.",
          Severity.Error);
    }
    finally
    {
      _saving = false;
    }
  }
}