@using Ansjon.UseCases.Abstractions.Messaging
@using Ansjon.UseCases.Houses.Commands.AddTenant
@using MudBlazor

@inject ISender Sender
@inject ISnackbar Snackbar
@inject ILogger<AddTenantButton> Logger

<MudPaper Class="pa-4"
  Elevation="1"
  Style="border-radius: 12px;">

  <MudButton Variant="Variant.Filled"
    Color="Color.Primary"
    StartIcon="@Icons.Material.Filled.PersonAdd"
    FullWidth="true"
    OnClick="OpenForm">

    Lägg till boende

  </MudButton>

  @if (_isAdding)
  {
    <MudPaper Class="pa-4 mt-4"
      Elevation="0"
      Style="border-radius: 12px; border: 1px solid #e9edf2;">

      <MudText Typo="Typo.h6"
        Color="Color.Primary"
        Class="mb-4">

        Ny boende

      </MudText>

      <MudStack Spacing="3">

        <MudTextField Label="Förnamn"
          @bind-Value="_firstName"
          Variant="Variant.Outlined"
          Required="true"
          RequiredError="Förnamn är obligatoriskt" />

        <MudTextField Label="Efternamn"
          @bind-Value="_lastName"
          Variant="Variant.Outlined"
          Required="true"
          RequiredError="Efternamn är obligatoriskt" />

        <MudTextField Label="E-post"
          @bind-Value="_email"
          Variant="Variant.Outlined"
          InputType="InputType.Email"
          Required="true"
          RequiredError="E-post är obligatoriskt" />

        <MudTextField Label="Telefonnummer"
          @bind-Value="_phoneNumber"
          Variant="Variant.Outlined"
          Required="true"
          RequiredError="Telefonnummer är obligatoriskt" />

        <MudStack Row="true"
          Spacing="2"
          Justify="Justify.FlexEnd">

          <MudButton Variant="Variant.Outlined"
            Disabled="_saving"
            OnClick="Cancel">

            Avbryt

          </MudButton>

          <MudButton Variant="Variant.Filled"
            Color="Color.Success"
            Disabled="_saving"
            StartIcon="@Icons.Material.Filled.Save"
            OnClick="SaveTenantAsync">

            @(_saving ? "Sparar..." : "Spara")

          </MudButton>

        </MudStack>

      </MudStack>

    </MudPaper>
  }

</MudPaper>

@code {

  [Parameter]
  public Guid HouseId { get; set; }

  [Parameter]
  public EventCallback OnTenantAdded { get; set; }

  private bool _isAdding;
  private bool _saving;

  private string _firstName = string.Empty;
  private string _lastName = string.Empty;
  private string _email = string.Empty;
  private string _phoneNumber = string.Empty;

  private void OpenForm()
  {
    _isAdding = true;
  }

  private void Cancel()
  {
    ResetForm();
    _isAdding = false;
  }

  private async Task SaveTenantAsync()
  {
    if (_saving)
      return;

    if (string.IsNullOrWhiteSpace(_firstName) ||
        string.IsNullOrWhiteSpace(_lastName) ||
        string.IsNullOrWhiteSpace(_email) ||
        string.IsNullOrWhiteSpace(_phoneNumber))
    {
      Snackbar.Add(
          "Fyll i alla fält.",
          Severity.Warning);

      return;
    }

    try
    {
      _saving = true;

      var command = new AddHouseTenantCommand(
          HouseId,
          _firstName.Trim(),
          _lastName.Trim(),
          _email.Trim(),
          _phoneNumber.Trim());

      await Sender.Send(command);

      Snackbar.Add(
          "Boende skapades!",
          Severity.Success);

      ResetForm();
      _isAdding = false;

      await OnTenantAdded.InvokeAsync();
    }
    catch (Exception ex)
    {
      Logger.LogError(
          ex,
          "Error creating tenant for house {HouseId}",
          HouseId);

      Snackbar.Add(
          "Kunde inte skapa boende.",
          Severity.Error);
    }
    finally
    {
      _saving = false;
    }
  }

  private void ResetForm()
  {
    _firstName = string.Empty;
    _lastName = string.Empty;
    _email = string.Empty;
    _phoneNumber = string.Empty;
  }
}