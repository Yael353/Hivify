@using Ansjon.UseCases.Houses.DTOs
@using MudBlazor

<MudText Typo="Typo.h5"
         Color="Color.Primary"
         Class="font-weight-bold mb-3">
    Hantera hus
</MudText>

<MudText Typo="Typo.body2"
         Color="Color.Tertiary"
         Class="mb-4">
    Här kan du se alla hus, lägga till nya och hantera boende.
</MudText>

<MudDivider Class="mb-4" />

<MudGrid>

    <!-- Create -->
    <MudItem xs="12">
        <AddHouseButton OnHouseAdded="RefreshHouses" />
    </MudItem>

    <!-- List -->
    <MudItem xs="12">
        <MudPaper Class="pa-4"
                  Elevation="2"
                  Style="border-radius: 12px;">

            <MudText Typo="Typo.subtitle2"
                     Color="Color.Primary"
                     Class="font-weight-semibold mb-3">
                Alla hus
            </MudText>

            <AdminHouseList
                @ref="_houseList"
                OnHouseSelected="SelectHouse" />

        </MudPaper>
    </MudItem>

    <!-- Selected house -->
    @if (_selectedHouse is not null)
    {
        <MudItem xs="12">
            <AdminHouseDetails
                House="_selectedHouse"
                OnHouseUpdated="HandleHouseUpdated" />
        </MudItem>
    }

</MudGrid>

@code {

    private AdminHouseList? _houseList;

    private HouseListItemDto? _selectedHouse;

    private void SelectHouse(HouseListItemDto house)
    {
        _selectedHouse = house;
    }

    private async Task RefreshHouses()
    {
        if (_houseList is not null)
        {
            await _houseList.Refresh();
        }
    }

    private async Task HandleHouseUpdated()
    {
        await RefreshHouses();

        _selectedHouse = null;
    }
}