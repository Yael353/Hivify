@attribute [Authorize(Roles = "Admin")]

@using Ansjon.UseCases.Communications.FeedUseCases
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@using Ansjon.Core.Entities.Feed
@using Ansjon.UseCases.Communications.DTOs.FeedDtos

@inject UpdateFeed UpdateFeedHandler
@inject DeleteFeed DeleteFeedHandler
@inject ISnackbar Snackbar
@inject ILogger<AdminFeedCard> Logger



<MudCard Elevation="4">


	@if (_editing)
	{

		<MudCardContent Class="pa-6">

			<MudStack Spacing="3">


				<MudText Typo="Typo.h6">
					Redigera feed
				</MudText>


				<MudTextField Label="Titel"
											Variant="Variant.Outlined"
											@bind-Value="_updateDto.Title"
											Required="true" />


				<MudTextField Label="Innehåll"
											Variant="Variant.Outlined"
											TextArea="true"
											Lines="5"
											@bind-Value="_updateDto.Content" />


			</MudStack>


		</MudCardContent>



		<MudDivider />


		<MudCardActions Class="pa-4">


			<MudButton Color="Color.Success"
								 Variant="Variant.Filled"
								 StartIcon="@Icons.Material.Filled.Save"
								 Disabled="_saving"
								 OnClick="SaveAsync">


				@(_saving ? "Sparar..." : "Spara")


			</MudButton>



			<MudButton Color="Color.Secondary"
								 Variant="Variant.Outlined"
								 StartIcon="@Icons.Material.Filled.Close"
								 Disabled="_saving"
								 OnClick="Cancel">


				Avbryt


			</MudButton>


		</MudCardActions>

	}
	else
	{


		<MudCardHeader>


			<CardHeaderContent>


				<MudText Typo="Typo.h6">

					@Feed.Title

				</MudText>


			</CardHeaderContent>



			<CardHeaderActions>


				<MudIconButton Icon="@Icons.Material.Filled.Edit"
											 Color="Color.Primary"
											 OnClick="StartEdit" />


				<MudIconButton Icon="@Icons.Material.Filled.Delete"
											 Color="Color.Error"
											 OnClick="DeleteAsync" />


			</CardHeaderActions>


		</MudCardHeader>



		<MudDivider />



		<MudCardContent Class="pa-6">


			<MudText Typo="Typo.body1"
							 Style="white-space:pre-wrap;">


				@Feed.Content


			</MudText>



			<MudText Typo="Typo.caption"
							 Color="Color.Secondary"
							 Class="mt-4">


				@Feed.CreatedDate.ToString("yyyy-MM-dd HH:mm")


			</MudText>



		</MudCardContent>

	}

</MudCard>




@code
{


	[Parameter]
	public Feed Feed { get; set; } = default!;



	[Parameter]
	public EventCallback OnChanged { get; set; }



	private bool _editing;


	private bool _saving;



	private UpdateFeedDto _updateDto = new();



	private void StartEdit()
	{

		_updateDto = new UpdateFeedDto
		{
			Title = Feed.Title,
			Content = Feed.Content
		};


		_editing = true;

	}



	private void Cancel()
	{

		_editing = false;

		_updateDto = new();

	}



	private async Task SaveAsync()
	{

		if (_saving)
			return;


		try
		{

			_saving = true;


			_updateDto.Title =
					_updateDto.Title.Trim();


			_updateDto.Content =
					_updateDto.Content.Trim();



			await UpdateFeedHandler.UpdateFeedAsync(
					Feed.Id,
					_updateDto);



			Snackbar.Add(
					"Feed uppdaterades.",
					Severity.Success);



			_editing = false;


			await OnChanged.InvokeAsync();

		}
		catch (Exception ex)
		{

			Logger.LogError(
					ex,
					"Error updating feed {Id}",
					Feed.Id);


			Snackbar.Add(
					"Kunde inte uppdatera feed.",
					Severity.Error);

		}
		finally
		{
			_saving = false;
		}

	}



	private async Task DeleteAsync()
	{

		try
		{

			await DeleteFeedHandler.DeleteFeedAsync(
					Feed.Id);

			Snackbar.Add(
					"Feed borttagen.",
					Severity.Success);

			await OnChanged.InvokeAsync();

		}
		catch (Exception ex)
		{

			Logger.LogError(
					ex,
					"Error deleting feed {Id}",
					Feed.Id);


			Snackbar.Add(
					"Kunde inte ta bort feed.",
					Severity.Error);

		}

	}

}